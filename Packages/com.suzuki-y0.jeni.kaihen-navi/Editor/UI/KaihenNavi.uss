/* かいへんナビ — やさしいモードの見た目
   色は .kn-dark / .kn-light の変数で切り替える（Unity のスキンに合わせる） */

.kn-dark {
    --kn-bg: rgb(38, 38, 42);
    --kn-surface: rgb(50, 50, 56);
    --kn-surface-hover: rgb(60, 60, 68);
    --kn-border: rgb(72, 72, 80);
    --kn-text: rgb(232, 232, 236);
    --kn-text-sub: rgb(160, 160, 170);
    --kn-accent: rgb(236, 122, 168);
    --kn-accent-text: rgb(30, 20, 26);
    --kn-selected: rgba(236, 122, 168, 0.18);
    --kn-info: rgba(93, 169, 233, 0.16);
    --kn-info-border: rgb(93, 169, 233);
    --kn-ok: rgba(108, 192, 139, 0.16);
    --kn-ok-border: rgb(108, 192, 139);
    --kn-warn: rgba(242, 193, 78, 0.16);
    --kn-warn-border: rgb(242, 193, 78);
}

.kn-light {
    --kn-bg: rgb(246, 244, 246);
    --kn-surface: rgb(255, 255, 255);
    --kn-surface-hover: rgb(250, 240, 245);
    --kn-border: rgb(220, 214, 220);
    --kn-text: rgb(40, 36, 42);
    --kn-text-sub: rgb(110, 104, 114);
    --kn-accent: rgb(214, 84, 138);
    --kn-accent-text: rgb(255, 255, 255);
    --kn-selected: rgba(214, 84, 138, 0.12);
    --kn-info: rgba(60, 130, 200, 0.10);
    --kn-info-border: rgb(60, 130, 200);
    --kn-ok: rgba(60, 150, 95, 0.10);
    --kn-ok-border: rgb(60, 150, 95);
    --kn-warn: rgba(200, 150, 30, 0.12);
    --kn-warn-border: rgb(200, 150, 30);
}

.kn-root {
    flex-grow: 1;
    background-color: var(--kn-bg);
    color: var(--kn-text);
    font-size: 13px;
}

/* ---------------------------------------------------------------- ヘッダー */

.kn-header {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    background-color: var(--kn-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--kn-border);
}

.kn-header__titles {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 8px;
}

.kn-header__title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.kn-badge {
    font-size: 11px;
    padding: 2px 8px;
    margin-right: 4px;
    border-radius: 10px;
    background-color: var(--kn-selected);
    color: var(--kn-accent);
    -unity-font-style: bold;
}

.kn-badge--trial {
    background-color: var(--kn-warn);
    color: var(--kn-warn-border);
}

.kn-language {
    width: 110px;
    margin: 0 0 0 auto;
}

/* ---------------------------------------------------------------- 本体 */

.kn-body {
    flex-grow: 1;
}

.kn-body .unity-scroll-view__content-container {
    padding: 4px 12px 16px 12px;
}

.kn-step-header {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    margin-bottom: 6px;
}

.kn-step-number {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: var(--kn-accent);
    color: var(--kn-accent-text);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-right: 8px;
}

.kn-step-title {
    flex-grow: 1;
    font-size: 15px;
    -unity-font-style: bold;
}

.kn-section {
    margin-bottom: 4px;
}

.kn-heading {
    margin-top: 12px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    color: var(--kn-text);
}

.kn-hint {
    font-size: 11px;
    color: var(--kn-text-sub);
    white-space: normal;
    margin-top: 2px;
}

.kn-avatar-dropdown {
    margin: 0;
}

.kn-avatar-dropdown > .unity-label {
    min-width: 70px;
}

/* ---------------------------------------------------------------- カード */

.kn-cards {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.kn-card {
    width: 49%;
    min-height: 64px;
    flex-direction: row;
    align-items: center;
    margin: 0 0 6px 0;
    /* 選択中は枠が 2px になるので、その分だけ内側の余白を減らして中身の大きさを変えない */
    padding: 9px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: var(--kn-surface);
    -unity-text-align: middle-left;
    white-space: normal;
}

.kn-card:hover {
    background-color: var(--kn-surface-hover);
}

.kn-card--selected {
    border-color: var(--kn-accent);
    border-width: 2px;
    padding: 8px;
    background-color: var(--kn-selected);
}

.kn-card--locked {
    opacity: 0.6;
}

.kn-card__icon {
    width: 34px;
    height: 34px;
    min-width: 34px;
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

.kn-card__texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.kn-card--badged .kn-card__texts {
    padding-top: 10px;
}

.kn-card__title {
    -unity-font-style: bold;
    white-space: normal;
    color: var(--kn-text);
}

.kn-card__desc {
    font-size: 11px;
    white-space: normal;
    color: var(--kn-text-sub);
    margin-top: 2px;
}

.kn-card__badge {
    position: absolute;
    top: 4px;
    right: 6px;
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 8px;
    background-color: var(--kn-border);
    color: var(--kn-text-sub);
}

.kn-card__badge--lock {
    background-color: var(--kn-warn);
    color: var(--kn-warn-border);
}

/* ---------------------------------------------------------------- お知らせ */

.kn-notice {
    margin: 6px 0;
    padding: 8px 10px;
    border-radius: 6px;
    border-left-width: 4px;
}

.kn-notice__text {
    white-space: normal;
}

.kn-notice--info {
    background-color: var(--kn-info);
    border-left-color: var(--kn-info-border);
}

.kn-notice--ok {
    background-color: var(--kn-ok);
    border-left-color: var(--kn-ok-border);
}

.kn-notice--warn {
    background-color: var(--kn-warn);
    border-left-color: var(--kn-warn-border);
}

/* ---------------------------------------------------------------- ボタン */

.kn-button {
    height: 30px;
    padding: 0 14px;
    margin: 4px 6px 4px 0;
    border-radius: 6px;
    -unity-font-style: bold;
}

.kn-button--primary {
    background-color: var(--kn-accent);
    color: var(--kn-accent-text);
    border-width: 0;
}

.kn-button--primary:hover {
    opacity: 0.9;
}

.kn-button--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--kn-border);
}

.kn-button--small {
    height: 24px;
    padding: 0 10px;
    font-size: 12px;
}

.kn-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
}

.kn-grow {
    flex-grow: 1;
    margin-left: 0;
}

/* ---------------------------------------------------------------- チップ */

.kn-chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.kn-chip {
    height: 28px;
    padding: 0 14px;
    margin: 0 6px 6px 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: var(--kn-surface);
}

.kn-chip--selected {
    background-color: var(--kn-accent);
    border-color: var(--kn-accent);
    color: var(--kn-accent-text);
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------- スライダー */

.kn-slider {
    margin: 6px 0;
}

.kn-slider > .unity-label {
    min-width: 80px;
    -unity-font-style: bold;
}

.kn-slider .unity-base-slider__dragger {
    width: 18px;
    height: 18px;
    margin-top: -8px;
    border-radius: 9px;
}

.kn-hue-bar {
    height: 6px;
    margin: -4px 64px 6px 84px;
    border-radius: 3px;
}

/* ---------------------------------------------------------------- 一覧 */

.kn-list {
    margin: 4px 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: var(--kn-surface);
}

.kn-list__row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--kn-border);
}

.kn-list__toggle {
    margin-right: 6px;
}

.kn-list__texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.kn-list__title {
    -unity-font-style: bold;
}

.kn-list__sub {
    font-size: 11px;
    color: var(--kn-text-sub);
}

.kn-list__popup {
    width: 80px;
    margin: 0 0 0 4px;
}

.kn-list__field {
    margin: 0;
}

.kn-swatch {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    margin-right: 8px;
    border-width: 1px;
    border-color: var(--kn-border);
    -unity-background-scale-mode: scale-and-crop;
}

.kn-bits {
    margin-top: 6px;
    font-size: 12px;
    color: var(--kn-text-sub);
    white-space: normal;
}

/* ---------------------------------------------------------------- 矢印ボタン */

.kn-pads {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
}

.kn-pad {
    margin-right: 16px;
    margin-bottom: 6px;
}

.kn-pad--vertical {
    flex-direction: column;
}

.kn-pad__row {
    flex-direction: row;
    justify-content: center;
}

.kn-arrow {
    width: 64px;
    height: 52px;
    margin: 2px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: var(--kn-surface);
    align-items: center;
    justify-content: center;
}

.kn-arrow:hover {
    border-color: var(--kn-accent);
    background-color: var(--kn-selected);
}

.kn-arrow:active {
    background-color: var(--kn-accent);
}

.kn-arrow__glyph {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.kn-arrow__caption {
    font-size: 11px;
    -unity-text-align: middle-center;
}

.kn-rotate-row {
    flex-wrap: nowrap;
}

.kn-rotate-row__label {
    width: 110px;
}

/* ---------------------------------------------------------------- フッター */

.kn-footer {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    padding: 6px 12px;
    background-color: var(--kn-surface);
    border-top-width: 1px;
    border-top-color: var(--kn-border);
}

.kn-footer__info {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.kn-footer__label {
    color: var(--kn-text-sub);
}

/* ---------------------------------------------------------------- 自分用アバター */

.kn-avatar-status {
    margin-top: 6px;
}

.kn-mine {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: var(--kn-ok-border);
    background-color: var(--kn-ok);
}

.kn-mine__texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.kn-mine__title {
    -unity-font-style: bold;
    white-space: normal;
}

.kn-mine__sub {
    font-size: 11px;
    color: var(--kn-text-sub);
    white-space: normal;
    margin-top: 2px;
}

.kn-mine-later {
    justify-content: space-between;
}

.kn-avatar-row {
    align-items: flex-start;
    padding: 8px 6px;
}

.kn-avatar-row__thumb {
    width: 64px;
    height: 64px;
    min-width: 64px;
    margin-right: 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: var(--kn-surface);
    -unity-background-scale-mode: scale-to-fit;
}

.kn-avatar-row__buttons {
    margin-top: 6px;
}

/* ---------------------------------------------------------------- ①の二択 */

.kn-choices {
    flex-direction: column;
}

.kn-choice {
    width: 100%;
    min-height: 72px;
}

.kn-choice__icon {
    background-color: var(--kn-accent);
    font-size: 20px;
}

.kn-current {
    padding: 8px 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: var(--kn-surface);
}

.kn-current__name {
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}

/* ---------------------------------------------------------------- ドラッグして入れる枠・候補 */

.kn-drop {
    min-height: 64px;
    margin: 4px 0 8px 0;
    padding: 12px;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--kn-border);
    justify-content: center;
    align-items: center;
}

.kn-drop--over {
    border-color: var(--kn-accent);
    background-color: var(--kn-selected);
}

.kn-drop__text {
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--kn-text-sub);
}

.kn-drop__pick {
    margin-top: 8px;
    justify-content: center;
}

.kn-drop__field {
    flex-grow: 1;
    max-width: 420px;
}

.kn-suggest__row {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 6px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    -unity-text-align: middle-left;
}

.kn-suggest__row:hover {
    background-color: var(--kn-surface-hover);
}

.kn-suggest__row--selected {
    background-color: var(--kn-selected);
}

.kn-suggest__thumb {
    width: 40px;
    height: 40px;
    min-width: 40px;
    margin-right: 8px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.kn-attach {
    margin-bottom: 8px;
}

.kn-attach__chosen {
    align-items: center;
    padding: 6px 10px;
    border-radius: 6px;
    background-color: var(--kn-selected);
}

/* ---------------------------------------------------------------- 製品版の画面 */

.kn-readout {
    font-size: 13px;
    -unity-font-style: bold;
    margin: 4px 0 6px 0;
    white-space: normal;
}

/* 体型・身長 */
.kn-figure {
    flex-direction: row;
    align-items: flex-start;
}

.kn-figure__canvas {
    width: 55%;
    height: 420px;
    min-width: 200px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: rgb(30, 30, 36);
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 8px;
}

.kn-figure__side {
    flex-grow: 1;
    flex-shrink: 1;
}

.kn-figure__parts {
    flex-direction: row;
    flex-wrap: wrap;
}

.kn-figure__part {
    margin: 0 4px 4px 0;
}

.kn-figure__part--selected {
    background-color: var(--kn-accent);
    color: var(--kn-accent-text);
}

.kn-figure__controls {
    margin-top: 8px;
}

/* サムネイル */
.kn-thumb-preview {
    width: 100%;
    max-width: 480px;
    height: 270px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--kn-border);
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 6px;
}

/* ピンク色・アップロード先 */
.kn-pink {
    margin: 6px 0 10px 0;
    padding: 8px;
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: var(--kn-warn-border);
    background-color: var(--kn-warn);
}

.kn-upload {
    margin-top: 4px;
}

/* ---------------------------------------------------------------- メニュー整理 */

.kn-menu__row--hidden {
    opacity: 0.55;
}

.kn-menu__icon {
    width: 24px;
    height: 24px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
