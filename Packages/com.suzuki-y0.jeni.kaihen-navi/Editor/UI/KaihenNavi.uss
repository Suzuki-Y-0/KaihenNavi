/* VCC / ALCOM 風の静かな面と行。差し色は Unity の青のみ。 */
.kn-dark {
    --kn-bg: rgb(32, 32, 32);
    --kn-surface: rgb(40, 40, 40);
    --kn-surface-hover: rgb(50, 50, 50);
    --kn-border: rgb(56, 56, 56);
    --kn-text: rgb(222, 222, 222);
    --kn-text-sub: rgb(145, 145, 145);
    --kn-text-faint: rgb(115, 115, 115);
    --kn-ok: rgb(98, 180, 110);
    --kn-warn: rgb(222, 168, 48);
    --kn-row-line: rgba(255, 255, 255, 0.04);
    --kn-badge-bg: rgba(255, 255, 255, 0.07);
    --kn-drop-border: rgb(78, 78, 78);
    --kn-accent: rgb(58, 121, 187);
    --kn-accent-text: rgb(118, 170, 226);
    --kn-selected: rgba(58, 121, 187, 0.20);
}
.kn-light {
    --kn-bg: rgb(228, 228, 228);
    --kn-surface: rgb(235, 235, 235);
    --kn-surface-hover: rgb(218, 218, 218);
    --kn-border: rgb(190, 190, 190);
    --kn-text: rgb(38, 38, 38);
    --kn-text-sub: rgb(86, 86, 86);
    --kn-text-faint: rgb(94, 94, 94);
    --kn-ok: rgb(39, 112, 49);
    --kn-warn: rgb(222, 168, 48);
    --kn-row-line: rgba(0, 0, 0, 0.07);
    --kn-badge-bg: rgba(0, 0, 0, 0.07);
    --kn-drop-border: rgb(145, 145, 145);
    --kn-accent: rgb(46, 108, 176);
    --kn-accent-text: rgb(35, 91, 151);
    --kn-selected: rgba(46, 108, 176, 0.14);
}
.kn-root {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--kn-bg);
    color: var(--kn-text);
    font-size: 12px;
}
/* アバター帯。保存と履歴をここにまとめる。 */
.kn-avatar-area { flex-shrink: 0; }
.kn-header, .kn-current {
    flex-direction: row;
    align-items: center;
    min-height: 56px;
    padding: 8px 12px 8px 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--kn-border);
}
.kn-header { justify-content: space-between; }
.kn-header__title, .kn-current__name { font-size: 13px; -unity-font-style: bold; white-space: normal; margin: 0; }
.kn-current__thumbnail {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-right: 12px;
    border-radius: 6px;
    overflow: hidden;
    background-color: var(--kn-surface-hover);
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}
.kn-current__initial { font-size: 17px; -unity-font-style: bold; margin: 0; color: var(--kn-text-sub); }
.kn-current__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 8px; }
.kn-current__meta { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 2px; }
.kn-meta-text { color: var(--kn-text-sub); font-size: 11px; white-space: normal; margin: 0; }
.kn-meta-separator { color: var(--kn-text-faint); font-size: 11px; margin: 0 6px; }
.kn-save-dot { width: 6px; height: 6px; border-radius: 3px; flex-shrink: 0; margin-right: 6px; background-color: var(--kn-text-faint); }
.kn-save-dot--ok { background-color: var(--kn-ok); }
.kn-save-dot--dirty { background-color: var(--kn-warn); }
.kn-badge { color: var(--kn-text-sub); background-color: var(--kn-surface-hover); font-size: 11px; border-radius: 4px; padding: 0 4px; }
.kn-avatar-actions { flex-direction: row; flex-shrink: 0; align-items: center; }
.kn-avatar-actions .kn-button { height: 26px; margin: 0 4px 0 6px; }
.kn-icon-button { width: 26px; height: 26px; flex-shrink: 0; margin: 0 0 0 4px; padding: 0; border-width: 0; border-radius: 4px; background-color: transparent; color: var(--kn-text-sub); align-items: center; justify-content: center; }
.kn-icon-button:hover { background-color: var(--kn-surface-hover); }
.kn-icon-button:disabled { opacity: 0.4; }
.kn-icon-button .kn-nav-icon { margin: 0; }
.kn-compact-window .kn-current { flex-wrap: wrap; }
.kn-compact-window .kn-current__texts { flex-basis: 220px; }
.kn-compact-window .kn-avatar-actions { margin-top: 6px; margin-left: auto; }
.kn-language { width: 112px; margin: 4px 0 4px 8px; }
.kn-avatar-advice__text { font-size: 11px; color: var(--kn-text-sub); white-space: normal; margin: 4px 0 0 0; }
.kn-upload-check { display: none; flex-shrink: 0; }
.kn-compact-window .kn-upload-check { display: flex; }
.kn-upload-check .kn-notice { margin: 0; border-radius: 0; padding: 4px 16px; }
.kn-upload-check .kn-notice__text { white-space: normal; }
/* スクロールする機能一覧と、最下部に固定したアップロード確認。 */
.kn-workspace { flex-direction: row; flex-grow: 1; min-height: 0; }
.kn-navigation { width: 212px; min-width: 212px; flex-shrink: 0; background-color: var(--kn-surface); border-right-width: 1px; border-right-color: var(--kn-border); }
.kn-navigation-scroll { flex-grow: 1; min-height: 0; }
.kn-navigation-scroll .unity-scroll-view__content-container { padding: 0 6px 8px 6px; }
.kn-navigation-footer { flex-shrink: 0; margin: 0 6px 6px 6px; padding-top: 6px; border-top-width: 1px; border-top-color: var(--kn-border); }
.kn-nav-group { font-size: 10.5px; color: var(--kn-text-faint); -unity-font-style: bold; margin: 14px 10px 4px 10px; }
.kn-nav-item { flex-direction: row; align-items: center; height: 30px; flex-shrink: 0; margin: 0 0 1px 0; padding: 0 8px; background-color: transparent; border-width: 0; border-radius: 4px; color: var(--kn-text); -unity-text-align: middle-left; }
.kn-nav-item:hover { background-color: var(--kn-surface-hover); }
.kn-nav-item--selected, .kn-nav-item--selected:hover { background-color: var(--kn-selected); color: rgb(255, 255, 255); }
.kn-light .kn-nav-item--selected { color: var(--kn-text); }
.kn-nav-item__indicator { position: absolute; left: 0; top: 7px; bottom: 7px; width: 2px; border-radius: 2px; background-color: transparent; }
.kn-nav-item--selected .kn-nav-item__indicator { background-color: var(--kn-accent); }
.kn-nav-icon { width: 16px; height: 16px; flex-shrink: 0; margin-right: 9px; color: var(--kn-text-sub); }
.kn-nav-item--selected .kn-nav-icon { color: var(--kn-accent-text); }
.kn-nav-item__title { flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; }
.kn-nav-item__lock { color: var(--kn-text-faint); font-size: 10px; margin: 0 0 0 4px; flex-shrink: 0; }
.kn-nav-badge { min-width: 18px; height: 16px; font-size: 10px; color: var(--kn-text-sub); background-color: var(--kn-badge-bg); border-radius: 8px; padding: 0 5px; margin: 0 0 0 4px; -unity-text-align: middle-center; flex-shrink: 0; }
.kn-nav-badge--warn { color: rgb(30, 30, 30); background-color: var(--kn-warn); -unity-font-style: bold; }
.kn-nav-item .kn-nav-done { color: var(--kn-ok); margin: 0 0 0 4px; }
.kn-page { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; }
.kn-page-header { flex-shrink: 0; padding: 20px 24px 14px 24px; }
.kn-page-header__row { flex-direction: row; align-items: flex-start; }
.kn-page-header__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 8px; }
.kn-page-title { font-size: 17px; -unity-font-style: bold; white-space: normal; margin: 0 0 6px 0; }
.kn-page-description { font-size: 11.5px; color: var(--kn-text-sub); white-space: normal; margin: 0; }
.kn-page-scroll { flex-grow: 1; min-height: 0; }
/* 中身の高さをスクロール枠に合わせない（合わせると長いページで行が縮んで重なる） */
.kn-panel > *, .kn-panel > * > *, .kn-list > * { flex-shrink: 0; }
.kn-panel { flex-grow: 1; padding: 0 24px 16px 24px; }
.kn-panel--empty { align-items: center; justify-content: center; min-height: 320px; }
.kn-empty { color: var(--kn-text-sub); white-space: normal; -unity-text-align: middle-center; margin: 24px; }
.kn-compact { flex-shrink: 0; padding: 8px 16px; border-bottom-width: 1px; border-bottom-color: var(--kn-border); }
.kn-feature-popup { margin: 0; min-width: 0; }
.kn-check-row { padding-top: 10px; padding-bottom: 10px; }
.kn-check-success { flex-direction: row; align-items: center; margin-top: 18px; }
.kn-check-success .kn-nav-icon, .kn-check-success__text { color: var(--kn-ok); }
.kn-check-success__text { flex-shrink: 1; white-space: normal; margin: 0; }
/* アバターを選ぶ画面 */
.kn-chooser-scroll { flex-grow: 1; min-height: 0; }
.kn-chooser-scroll .unity-scroll-view__content-container { flex-grow: 1; justify-content: center; padding: 24px; }
.kn-chooser { width: 100%; max-width: 800px; align-self: center; }
.kn-choices { flex-direction: row; flex-wrap: wrap; margin-top: 16px; margin-bottom: 24px; }
.kn-choice {
    flex-grow: 1;
    flex-basis: 280px;
    min-width: 0;
    min-height: 160px;
    align-items: flex-start;
    justify-content: center;
    margin: 0 8px 8px 0;
    padding: 24px;
    border-width: 1px;
    border-color: var(--kn-border);
    border-radius: 6px;
    background-color: var(--kn-surface);
    color: var(--kn-text);
    -unity-text-align: middle-left;
}
.kn-choice:hover { background-color: var(--kn-surface-hover); border-color: var(--kn-accent); }
.kn-choice__icon { font-size: 24px; color: var(--kn-text-sub); margin: 0 0 16px 0; }
.kn-choice__texts { align-self: stretch; }
.kn-choice__title { font-size: 13px; -unity-font-style: bold; white-space: normal; margin: 0 0 8px 0; }
.kn-choice__desc { font-size: 11px; color: var(--kn-text-sub); white-space: normal; margin: 0; }
.kn-compact-window .kn-chooser-scroll .unity-scroll-view__content-container { padding: 16px; }
.kn-compact-window .kn-choice { flex-basis: 100%; min-height: 128px; margin-right: 0; padding: 16px; }
/* 見出しと案内 */
.kn-step-header { flex-direction: row; align-items: center; margin: 18px 0 8px 0; }
.kn-step-title { flex-grow: 1; font-size: 11px; color: var(--kn-text-sub); -unity-font-style: bold; white-space: normal; }
.kn-heading { font-size: 11px; margin: 18px 0 8px 0; -unity-font-style: bold; color: var(--kn-text-sub); white-space: normal; }
.kn-hint { font-size: 11px; color: var(--kn-text-sub); white-space: normal; margin: 4px 0; }
.kn-notice {
    flex-direction: row;
    align-items: center;
    margin: 8px 0;
    padding: 8px 12px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: var(--kn-surface);
}
.kn-notice__icon { width: 16px; height: 16px; margin-right: 8px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.kn-notice__text { flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: normal; margin: 0; }
/* 説明は本文に溶け込ませ、警告の枠を目立たせる。 */
.kn-notice--info { padding: 0; border-width: 0; background-color: transparent; color: var(--kn-text-sub); font-size: 11.5px; }
.kn-notice--info .kn-notice__icon { display: none; }
/* ボタン */
.kn-button {
    height: 32px;
    flex-shrink: 0;
    padding: 0 12px;
    margin: 4px 8px 4px 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: var(--kn-surface-hover);
    color: var(--kn-text);
}
.kn-button:hover { background-color: var(--kn-surface); border-color: var(--kn-text-sub); }
.kn-button--primary { background-color: var(--kn-accent); color: rgb(255, 255, 255); border-color: var(--kn-accent); }
.kn-button--primary:hover { background-color: var(--kn-accent); border-color: var(--kn-accent-text); }
.kn-button--ghost { background-color: transparent; }
.kn-button--small { height: 24px; padding: 0 8px; font-size: 11px; }
.kn-button:disabled, .kn-chip:disabled { opacity: 0.5; }
.kn-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 4px; }
.kn-grow { flex-grow: 1; min-width: 0; }
/* セグメント切り替え */
.kn-chips { flex-direction: row; flex-wrap: wrap; margin: 4px 0 8px 0; }
.kn-chip {
    min-height: 28px;
    padding: 4px 12px;
    margin: 0 0 4px 0;
    border-radius: 0;
    border-width: 1px;
    border-left-width: 0;
    border-color: var(--kn-border);
    background-color: var(--kn-surface);
    color: var(--kn-text);
}
.kn-chip--first { border-left-width: 1px; border-top-left-radius: 4px; border-bottom-left-radius: 4px; }
.kn-chip--last { border-top-right-radius: 4px; border-bottom-right-radius: 4px; }
.kn-chip:hover { background-color: var(--kn-surface-hover); }
.kn-chip--selected, .kn-chip--selected:hover { background-color: var(--kn-selected); color: var(--kn-accent); }
/* スライダー。色見本はアバターの色を表示するためテーマの差し色とは別。 */
.kn-slider { margin: 8px 0; }
.kn-slider > .unity-label { min-width: 80px; }
.kn-hue-bar { height: 4px; margin: -4px 64px 8px 84px; border-radius: 4px; }
/* 一覧を表の行としてそろえる */
.kn-list { margin: 8px 0; }
.kn-list__row {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    padding: 4px 8px;
    border-radius: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--kn-row-line);
}
.kn-list__row:hover { background-color: var(--kn-surface-hover); }
.kn-list__toggle { margin-right: 8px; }
.kn-list__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.kn-list__title { white-space: normal; margin: 0; }
.kn-list__sub { font-size: 11px; color: var(--kn-text-sub); white-space: normal; margin: 1px 0 0 0; }
.kn-list__popup { width: 80px; margin: 0 0 0 4px; }
.kn-list__field { margin: 0; }
.kn-swatch { width: 28px; height: 28px; flex-shrink: 0; border-radius: 4px; margin-right: 8px; border-width: 1px; border-color: var(--kn-border); -unity-background-scale-mode: scale-and-crop; }
.kn-bits { margin-top: 8px; font-size: 11px; color: var(--kn-text-sub); white-space: normal; }
.kn-avatar-row { align-items: flex-start; padding: 8px; }
.kn-avatar-row__thumb, .kn-suggest__thumb { width: 32px; height: 32px; min-width: 32px; flex-shrink: 0; margin-right: 8px; border-radius: 4px; background-color: var(--kn-surface); -unity-background-scale-mode: scale-to-fit; }
.kn-avatar-row__buttons { margin-top: 8px; }
.kn-suggest__row { flex-direction: row; align-items: center; margin: 0; padding: 4px 8px; min-height: 44px; border-width: 0; border-bottom-width: 1px; border-bottom-color: var(--kn-row-line); border-radius: 4px; background-color: transparent; color: var(--kn-text); -unity-text-align: middle-left; }
.kn-suggest__row:hover { background-color: var(--kn-surface-hover); }
.kn-suggest__row--selected { background-color: var(--kn-selected); }
/* 移動・回転 */
.kn-pads { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 4px; }
.kn-pad { margin-right: 16px; margin-bottom: 8px; }
.kn-pad--vertical { flex-direction: column; }
.kn-pad__row { flex-direction: row; justify-content: center; }
.kn-arrow { width: 64px; height: 48px; margin: 4px; border-radius: 4px; border-width: 1px; border-color: var(--kn-border); background-color: var(--kn-surface); color: var(--kn-text); align-items: center; justify-content: center; }
.kn-arrow:hover { border-color: var(--kn-accent); background-color: var(--kn-selected); }
.kn-arrow:active { background-color: var(--kn-accent); color: rgb(255, 255, 255); }
.kn-arrow__glyph { font-size: 20px; -unity-text-align: middle-center; }
.kn-arrow__caption { font-size: 11px; -unity-text-align: middle-center; }
.kn-rotate-row { flex-wrap: nowrap; }
.kn-rotate-row__label { width: 112px; }
/* フッター */
.kn-footer { flex-direction: row; height: 24px; flex-shrink: 0; align-items: center; padding: 0 16px; background-color: var(--kn-surface); border-top-width: 1px; border-top-color: var(--kn-border); }
.kn-footer__info { flex-grow: 1; min-width: 0; flex-direction: row; align-items: center; }
.kn-footer__label { font-size: 11px; color: var(--kn-text-faint); margin: 0; }
/* アイテムを選ぶ。破線は Painter2D が描く。 */
.kn-drop { flex-direction: row; flex-wrap: wrap; min-height: 64px; margin: 4px 0 8px 0; padding: 10px 16px; border-radius: 6px; color: var(--kn-drop-border); align-items: center; }
.kn-drop--over { color: var(--kn-accent); background-color: var(--kn-selected); }
.kn-drop__icon { color: var(--kn-text-faint); margin-right: 14px; }
.kn-drop__texts { flex-grow: 1; flex-shrink: 1; min-width: 100px; margin-right: 8px; }
.kn-drop__text { white-space: normal; color: var(--kn-text); margin: 0; }
.kn-drop__hint { font-size: 11px; white-space: normal; color: var(--kn-text-sub); margin: 2px 0 0 0; }
.kn-drop .kn-button { margin: 4px 0 4px auto; }
.kn-drop__pick { padding: 8px 12px; align-items: center; }
.kn-drop__field { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.kn-attach { margin-bottom: 8px; }
.kn-attach__chosen { align-items: center; padding: 8px 12px; border-radius: 4px; background-color: var(--kn-selected); }
.kn-kono-row { flex-direction: row; align-items: center; }
.kn-kono-row > .kn-suggest__row { flex-grow: 1; flex-shrink: 1; min-width: 0; }
/* 機能ごとのプレビュー */
.kn-readout { font-size: 13px; -unity-font-style: bold; margin: 4px 0 8px 0; white-space: normal; }
.kn-figure { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.kn-figure__canvas { width: 55%; height: 420px; min-width: 200px; border-radius: 6px; border-width: 1px; border-color: var(--kn-border); background-color: var(--kn-surface); -unity-background-scale-mode: scale-to-fit; margin-right: 8px; }
.kn-figure__side { flex-grow: 1; flex-shrink: 1; }
.kn-figure__parts { flex-direction: row; flex-wrap: wrap; }
.kn-figure__part { margin: 0 4px 4px 0; }
.kn-figure__part--selected { background-color: var(--kn-selected); color: var(--kn-accent); }
.kn-figure__controls { margin-top: 8px; }
.kn-compact-window .kn-figure { flex-direction: column; align-items: stretch; }
.kn-compact-window .kn-figure__canvas { width: auto; margin: 0 0 8px 0; }
.kn-compact-window .kn-figure__side { flex-shrink: 0; }
.kn-thumb-preview { width: 100%; max-width: 480px; height: 270px; border-radius: 6px; border-width: 1px; border-color: var(--kn-border); -unity-background-scale-mode: scale-to-fit; margin-bottom: 8px; }
.kn-issue { margin: 8px 0; padding: 8px; border-radius: 6px; border-width: 1px; border-color: var(--kn-border); background-color: var(--kn-surface); }
.kn-menu__row--hidden { opacity: 0.55; }
.kn-menu__icon { width: 28px; height: 28px; margin-right: 8px; flex-shrink: 0; border-radius: 4px; -unity-background-scale-mode: scale-to-fit; }

/* 商品の詳細と、一覧にないアイテムを入れる補助欄。 */
.kn-library__detail { padding: 12px; margin: 0 4px 8px 4px; background-color: var(--kn-surface); border-radius: 4px; border-width: 1px; border-color: var(--kn-border); }
.kn-library__image { width: 128px; height: 128px; min-width: 128px; margin-bottom: 8px; }
.kn-drop--compact { min-height: 40px; padding: 6px 8px; }
.kn-drop--compact .kn-drop__icon, .kn-drop--compact .kn-drop__hint { display: none; }
/* 履歴は本文の上に重ね、開閉してもナビやページの配置を変えない。 */
.kn-history-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.kn-button.kn-history-dismiss {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    margin: 0; padding: 0; border-width: 0; border-radius: 0;
    background-color: rgba(0, 0, 0, 0.12);
}
.kn-history {
    position: absolute; top: 56px; right: 12px; width: 480px;
    max-width: 94%; max-height: 80%; padding: 12px;
    background-color: var(--kn-surface); color: var(--kn-text);
    border-width: 1px; border-color: var(--kn-border); border-radius: 6px;
}
.kn-history__header { justify-content: space-between; flex-shrink: 0; }
.kn-history > .kn-hint { flex-shrink: 0; }
.kn-history__scroll { flex-shrink: 1; min-height: 0; }
.kn-history__session { flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: var(--kn-border); }
.kn-button.kn-history__summary {
    flex-direction: column; align-items: flex-start;
    border-width: 0; margin: 0; padding: 10px 8px;
    background-color: var(--kn-surface);
}
.kn-button.kn-history__summary:hover { background-color: var(--kn-surface-hover); }
.kn-button.kn-history__summary--open { background-color: var(--kn-selected); }
.kn-history__summary .kn-list__title { white-space: normal; }
.kn-history__steps { padding-left: 12px; }
.kn-history__step { flex-wrap: wrap; }
.kn-history__step .kn-list__texts { min-width: 130px; }

/* 持っている服・アクセの検索欄 */
.kn-search { margin: 2px 0 8px 0; }
.kn-search > .unity-text-field__input { min-height: 26px; padding: 0 8px; border-radius: 4px; }
