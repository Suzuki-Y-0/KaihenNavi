/* VCC / ALCOM 風の静かな面と行。差し色は Unity の青のみ。 */
.kn-dark {
    --kn-bg: rgb(32, 32, 32);
    --kn-surface: rgb(42, 42, 42);
    --kn-surface-hover: rgb(52, 52, 52);
    --kn-border: rgb(60, 60, 60);
    --kn-text: rgb(222, 222, 222);
    --kn-text-sub: rgb(150, 150, 150);
    --kn-accent: rgb(58, 121, 187);
    --kn-accent-text: rgb(255, 255, 255);
    --kn-selected: rgba(58, 121, 187, 0.22);
}
.kn-light {
    --kn-bg: rgb(214, 214, 214);
    --kn-surface: rgb(228, 228, 228);
    --kn-surface-hover: rgb(240, 240, 240);
    --kn-border: rgb(190, 190, 190);
    --kn-text: rgb(38, 38, 38);
    --kn-text-sub: rgb(100, 100, 100);
    --kn-accent: rgb(46, 108, 176);
    --kn-accent-text: rgb(255, 255, 255);
    --kn-selected: rgba(46, 108, 176, 0.14);
}
.kn-root {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--kn-bg);
    color: var(--kn-text);
    font-size: 12px;
}
/* アバター帯 */
.kn-avatar-area { flex-shrink: 0; }
.kn-header, .kn-current {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background-color: var(--kn-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--kn-border);
}
.kn-header__title, .kn-current__name {
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
    margin: 0 0 4px 0;
}
.kn-current__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 16px; }
.kn-status-chips { flex-direction: row; flex-wrap: wrap; }
.kn-status-chip, .kn-badge {
    color: var(--kn-text-sub);
    background-color: var(--kn-surface-hover);
    font-size: 11px;
    border-radius: 4px;
    padding: 0 4px;
    margin: 0 4px 4px 0;
}
.kn-avatar-actions { flex-direction: row; flex-wrap: wrap; flex-shrink: 1; max-width: 100%; align-items: center; }
.kn-compact-window .kn-current { flex-direction: column; align-items: stretch; }
.kn-compact-window .kn-current__texts { margin-right: 0; }
.kn-compact-window .kn-avatar-actions .kn-language { margin-left: 0; }
.kn-language { width: 112px; margin: 4px 0 4px 8px; }
.kn-avatar-advice { padding-left: 16px; padding-right: 16px; }
.kn-avatar-advice .kn-notice { margin-top: 4px; }
.kn-upload-check { flex-shrink: 0; }
.kn-upload-check .kn-notice { margin: 0; border-radius: 0; padding: 4px 16px; }
.kn-upload-check .kn-notice__text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
/* 独立してスクロールするナビとページ */
.kn-workspace { flex-direction: row; flex-grow: 1; min-height: 0; }
.kn-navigation {
    width: 240px;
    min-width: 240px;
    flex-shrink: 0;
    background-color: var(--kn-surface);
    border-right-width: 1px;
    border-right-color: var(--kn-border);
}
.kn-navigation .unity-scroll-view__content-container { padding: 8px; }
.kn-nav-group {
    font-size: 11px;
    color: var(--kn-text-sub);
    -unity-font-style: bold;
    margin: 16px 8px 8px 8px;
}
.kn-nav-item {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    flex-shrink: 0;
    margin: 0 0 4px 0;
    padding: 8px;
    background-color: transparent;
    border-width: 0;
    border-left-width: 2px;
    border-left-color: transparent;
    border-radius: 4px;
    color: var(--kn-text);
    -unity-text-align: middle-left;
}
.kn-nav-item:hover { background-color: var(--kn-surface-hover); }
.kn-nav-item--selected {
    background-color: var(--kn-selected);
    border-left-color: var(--kn-accent);
    color: var(--kn-accent);
}
.kn-nav-item--selected:hover { background-color: var(--kn-selected); }
.kn-nav-icon { width: 16px; height: 16px; flex-shrink: 0; margin-right: 8px; }
.kn-nav-item__title { flex-grow: 1; flex-shrink: 1; white-space: normal; margin: 0; }
.kn-nav-item__lock { color: var(--kn-text-sub); font-size: 10px; margin-left: 4px; flex-shrink: 0; }
.kn-page { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; }
.kn-page-header { flex-shrink: 0; }
.kn-page-header__row {
    flex-direction: row;
    align-items: flex-start;
    padding: 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--kn-border);
}
.kn-page-header__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 8px; }
.kn-page-title { font-size: 16px; -unity-font-style: bold; white-space: normal; margin: 0 0 8px 0; }
.kn-page-description { font-size: 11px; color: var(--kn-text-sub); white-space: normal; margin: 0; }
.kn-page-scroll { flex-grow: 1; min-height: 0; }
.kn-page-scroll .unity-scroll-view__content-container { flex-grow: 1; }
.kn-panel { flex-grow: 1; padding: 16px; }
.kn-panel--empty { align-items: center; justify-content: center; }
.kn-empty { color: var(--kn-text-sub); white-space: normal; -unity-text-align: middle-center; margin: 24px; }
.kn-compact { flex-shrink: 0; padding: 8px 16px; border-bottom-width: 1px; border-bottom-color: var(--kn-border); }
.kn-feature-popup { margin: 0; min-width: 0; }
/* アバターを選ぶ画面 */
.kn-chooser-scroll { flex-grow: 1; min-height: 0; }
.kn-chooser-scroll .unity-scroll-view__content-container { flex-grow: 1; justify-content: center; padding: 24px; }
.kn-chooser { width: 100%; max-width: 800px; align-self: center; }
.kn-choices { flex-direction: row; flex-wrap: wrap; margin-top: 16px; margin-bottom: 24px; }
.kn-choice {
    flex-grow: 1;
    flex-basis: 280px;
    min-width: 0;
    min-height: 160px;
    align-items: flex-start;
    justify-content: center;
    margin: 0 8px 8px 0;
    padding: 24px;
    border-width: 1px;
    border-color: var(--kn-border);
    border-radius: 6px;
    background-color: var(--kn-surface);
    color: var(--kn-text);
    -unity-text-align: middle-left;
}
.kn-choice:hover { background-color: var(--kn-surface-hover); border-color: var(--kn-accent); }
.kn-choice__icon { font-size: 24px; color: var(--kn-text-sub); margin: 0 0 16px 0; }
.kn-choice__texts { align-self: stretch; }
.kn-choice__title { font-size: 13px; -unity-font-style: bold; white-space: normal; margin: 0 0 8px 0; }
.kn-choice__desc { font-size: 11px; color: var(--kn-text-sub); white-space: normal; margin: 0; }
.kn-compact-window .kn-chooser-scroll .unity-scroll-view__content-container { padding: 16px; }
.kn-compact-window .kn-choice { flex-basis: 100%; min-height: 128px; margin-right: 0; padding: 16px; }
/* 見出しと案内 */
.kn-step-header {
    flex-direction: row;
    align-items: center;
    margin: 16px 0 8px 0;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--kn-border);
}
.kn-step-title { flex-grow: 1; -unity-font-style: bold; white-space: normal; }
.kn-heading { margin: 16px 0 8px 0; -unity-font-style: bold; color: var(--kn-text); white-space: normal; }
.kn-hint { font-size: 11px; color: var(--kn-text-sub); white-space: normal; margin: 4px 0; }
.kn-notice {
    flex-direction: row;
    align-items: center;
    margin: 8px 0;
    padding: 8px 12px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: var(--kn-surface);
}
.kn-notice__icon { width: 16px; height: 16px; margin-right: 8px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.kn-notice__text { flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: normal; margin: 0; }
/* ボタン */
.kn-button {
    height: 32px;
    flex-shrink: 0;
    padding: 0 12px;
    margin: 4px 8px 4px 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--kn-border);
    background-color: var(--kn-surface-hover);
    color: var(--kn-text);
}
.kn-button:hover { background-color: var(--kn-surface); border-color: var(--kn-text-sub); }
.kn-button--primary { background-color: var(--kn-accent); color: var(--kn-accent-text); border-color: var(--kn-accent); }
.kn-button--primary:hover { background-color: var(--kn-accent); border-color: var(--kn-accent-text); }
.kn-button--ghost { background-color: transparent; }
.kn-button--small { height: 24px; padding: 0 8px; font-size: 11px; }
.kn-button:disabled, .kn-chip:disabled { opacity: 0.5; }
.kn-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 4px; }
.kn-grow { flex-grow: 1; min-width: 0; }
/* セグメント切り替え */
.kn-chips { flex-direction: row; flex-wrap: wrap; margin: 4px 0 8px 0; }
.kn-chip {
    min-height: 28px;
    padding: 4px 12px;
    margin: 0 0 4px 0;
    border-radius: 0;
    border-width: 1px;
    border-left-width: 0;
    border-color: var(--kn-border);
    background-color: var(--kn-surface);
    color: var(--kn-text);
}
.kn-chip--first { border-left-width: 1px; border-top-left-radius: 4px; border-bottom-left-radius: 4px; }
.kn-chip--last { border-top-right-radius: 4px; border-bottom-right-radius: 4px; }
.kn-chip:hover { background-color: var(--kn-surface-hover); }
.kn-chip--selected, .kn-chip--selected:hover { background-color: var(--kn-selected); color: var(--kn-accent); }
/* スライダー。色見本はアバターの色を表示するためテーマの差し色とは別。 */
.kn-slider { margin: 8px 0; }
.kn-slider > .unity-label { min-width: 80px; }
.kn-hue-bar { height: 4px; margin: -4px 64px 8px 84px; border-radius: 4px; }
/* 一覧を表の行としてそろえる */
.kn-list { margin: 8px 0; border-radius: 6px; border-width: 1px; border-color: var(--kn-border); background-color: var(--kn-surface); }
.kn-list__row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--kn-border);
}
.kn-list__row:hover { background-color: var(--kn-surface-hover); }
.kn-list__toggle { margin-right: 8px; }
.kn-list__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.kn-list__title { white-space: normal; }
.kn-list__sub { font-size: 11px; color: var(--kn-text-sub); white-space: normal; }
.kn-list__popup { width: 80px; margin: 0 0 0 4px; }
.kn-list__field { margin: 0; }
.kn-swatch { width: 28px; height: 28px; flex-shrink: 0; border-radius: 4px; margin-right: 8px; border-width: 1px; border-color: var(--kn-border); -unity-background-scale-mode: scale-and-crop; }
.kn-bits { margin-top: 8px; font-size: 11px; color: var(--kn-text-sub); white-space: normal; }
.kn-avatar-row { align-items: flex-start; padding: 8px; }
.kn-avatar-row__thumb, .kn-suggest__thumb { width: 32px; height: 32px; min-width: 32px; flex-shrink: 0; margin-right: 8px; border-radius: 4px; background-color: var(--kn-surface); -unity-background-scale-mode: scale-to-fit; }
.kn-avatar-row__buttons { margin-top: 8px; }
.kn-suggest__row { flex-direction: row; align-items: center; margin: 0; padding: 8px; min-height: 32px; border-width: 0; border-bottom-width: 1px; border-bottom-color: var(--kn-border); border-radius: 0; background-color: transparent; color: var(--kn-text); -unity-text-align: middle-left; }
.kn-suggest__row:hover { background-color: var(--kn-surface-hover); }
.kn-suggest__row--selected { background-color: var(--kn-selected); }
/* 移動・回転 */
.kn-pads { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 4px; }
.kn-pad { margin-right: 16px; margin-bottom: 8px; }
.kn-pad--vertical { flex-direction: column; }
.kn-pad__row { flex-direction: row; justify-content: center; }
.kn-arrow { width: 64px; height: 48px; margin: 4px; border-radius: 4px; border-width: 1px; border-color: var(--kn-border); background-color: var(--kn-surface); color: var(--kn-text); align-items: center; justify-content: center; }
.kn-arrow:hover { border-color: var(--kn-accent); background-color: var(--kn-selected); }
.kn-arrow:active { background-color: var(--kn-accent); color: var(--kn-accent-text); }
.kn-arrow__glyph { font-size: 20px; -unity-text-align: middle-center; }
.kn-arrow__caption { font-size: 11px; -unity-text-align: middle-center; }
.kn-rotate-row { flex-wrap: nowrap; }
.kn-rotate-row__label { width: 112px; }
/* フッター */
.kn-footer { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; align-items: center; padding: 4px 16px; background-color: var(--kn-surface); border-top-width: 1px; border-top-color: var(--kn-border); }
.kn-footer__info { flex-grow: 1; flex-direction: row; align-items: center; }
.kn-footer__label { font-size: 11px; color: var(--kn-text-sub); }
.kn-footer .kn-button { height: 24px; font-size: 11px; }
/* アイテムを選ぶ */
.kn-drop { min-height: 64px; margin: 4px 0 8px 0; padding: 16px; border-radius: 6px; border-width: 1px; border-color: var(--kn-border); background-color: var(--kn-surface); justify-content: center; align-items: center; }
.kn-drop--over { border-color: var(--kn-accent); background-color: var(--kn-selected); }
.kn-drop__text { white-space: normal; -unity-text-align: middle-center; color: var(--kn-text-sub); }
.kn-drop__pick { margin-top: 8px; justify-content: center; }
.kn-drop__field { flex-grow: 1; max-width: 420px; }
.kn-attach { margin-bottom: 8px; }
.kn-attach__chosen { align-items: center; padding: 8px 12px; border-radius: 4px; background-color: var(--kn-selected); }
.kn-kono-row { flex-direction: row; align-items: center; }
.kn-kono-row > .kn-suggest__row { flex-grow: 1; flex-shrink: 1; min-width: 0; }
/* 機能ごとのプレビュー */
.kn-readout { font-size: 13px; -unity-font-style: bold; margin: 4px 0 8px 0; white-space: normal; }
.kn-figure { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.kn-figure__canvas { width: 55%; height: 420px; min-width: 200px; border-radius: 6px; border-width: 1px; border-color: var(--kn-border); background-color: var(--kn-surface); -unity-background-scale-mode: scale-to-fit; margin-right: 8px; }
.kn-figure__side { flex-grow: 1; flex-shrink: 1; }
.kn-figure__parts { flex-direction: row; flex-wrap: wrap; }
.kn-figure__part { margin: 0 4px 4px 0; }
.kn-figure__part--selected { background-color: var(--kn-selected); color: var(--kn-accent); }
.kn-figure__controls { margin-top: 8px; }
.kn-compact-window .kn-figure__canvas { width: 100%; margin: 0 0 8px 0; }
.kn-thumb-preview { width: 100%; max-width: 480px; height: 270px; border-radius: 6px; border-width: 1px; border-color: var(--kn-border); -unity-background-scale-mode: scale-to-fit; margin-bottom: 8px; }
.kn-issue { margin: 8px 0; padding: 8px; border-radius: 6px; border-width: 1px; border-color: var(--kn-border); background-color: var(--kn-surface); }
.kn-menu__row--hidden { opacity: 0.55; }
.kn-menu__icon { width: 28px; height: 28px; margin-right: 8px; flex-shrink: 0; border-radius: 4px; -unity-background-scale-mode: scale-to-fit; }
