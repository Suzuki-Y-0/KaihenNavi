+
+/// <summary>バックアップからメニューを作り直したとき用。作ったときの初期値を元の表示状態として記録する。</summary>
+internal static void WriteVisibilityFromMenu(VRCAvatarDescriptor avatar, MenuData menu)
+{
+    if (menu == null) return;
+    var data = new ToggleVisibilityData();
+    foreach (var item in menu.items)
+    {
+        if (string.IsNullOrEmpty(item.targetPath)) continue;
+        data.items.Add(new ToggleVisibilityEntry { path = item.targetPath, active = item.isDefault });
+    }
+
+    SaveVisibility(avatar, data);
+}
+
+private static void SaveVisibility(VRCAvatarDescriptor avatar, ToggleVisibilityData data)
+{
     var folder = WorkFolders.Ensure(WorkFolders.ForAvatar(avatar.gameObject) + "/Menus");
     var pathOnDisk = folder + "/ToggleMenuStates.json";
     File.WriteAllText(pathOnDisk, JsonUtility.ToJson(data, true), new UTF8Encoding(false));
     AssetDatabase.ImportAsset(pathOnDisk);

