using System;
using System.Collections.Generic;
using System.Linq;
using UnityEditor;
using UnityEngine;
using UnityEngine.UIElements;
using VRC.SDK3.Avatars.Components;

namespace Jeni.KaihenNavi
{
    /// <summary>
    /// 機能 6：アクセをつけたい。
    /// アクセの Prefab を選び、「頭」「首」などの場所を選ぶだけで体の骨に付ける（ヒエラルキーの親子関係は触らせない）。
    /// 付けたあとは、その場で位置・向き・大きさをスライダーで調整できる。
    /// 変更はすべて Ctrl+Z 1 回で戻せるよう、1 操作を 1 つの Undo グループにまとめる。
    /// </summary>
    internal sealed class TransformFeature : FeatureBase
    {
        /// <summary>付けたときの状態。「推定した位置に戻す」で使う。</summary>
        private sealed class Baseline
        {
            public Vector3 LocalPosition;
            public Quaternion LocalRotation;
            public Vector3 LocalScale;
        }

        private static GameObject _target;

        // 調整パネルを開いているか
        private static bool _adjusting;

        // これから付けるアクセ（Prefab）と、付ける場所
        private static GameObject _pending;
        private static int _placeIndex;

        private static readonly HumanBodyBones[] Places =
        {
            HumanBodyBones.Head, HumanBodyBones.Neck, HumanBodyBones.Chest, HumanBodyBones.Hips,
            HumanBodyBones.RightHand, HumanBodyBones.LeftHand, HumanBodyBones.RightFoot, HumanBodyBones.LeftFoot,
        };

        private static readonly string[] PlaceKeys =
        {
            "attach.head", "attach.neck", "attach.chest", "attach.hips",
            "attach.rightHand", "attach.leftHand", "attach.rightFoot", "attach.leftFoot",
        };

        private readonly Dictionary<GameObject, Baseline> _baselines = new Dictionary<GameObject, Baseline>();

        // スライダーの値（付けたときからの差分）。対象が変わったときだけ 0 に戻す。
        private GameObject _offsetsFor;
        private float _upCm;
        private float _forwardCm;
        private float _rightCm;
        private float _yaw;
        private float _pitch;
        private float _roll;
        private Slider _size;

        public override string Id { get { return "transform"; } }
        public override int Number { get { return 6; } }
        public override Color Accent { get { return Ui.Hex("#6FA8DC"); } }
        public override bool InTrial { get { return true; } }

        public override bool RefreshOnHierarchyChange { get { return true; } }

        /// <summary>既存の候補一覧と同じ方法で、装着済みの数を表示する。</summary>
        public override string NavBadge(VRCAvatarDescriptor avatar)
        {
            var count = avatar == null ? 0 : FindTargets(avatar).Count;
            return count == 0 ? null : count.ToString();
        }

        public override VisualElement Build(FeatureContext ctx)
        {
            var root = new VisualElement();
            var avatar = ctx.Avatar;
            root.Add(BuildAttach(ctx));

            var targets = FindTargets(avatar);

            if (_target != null && (!_target.transform.IsChildOf(avatar.transform) || _target == avatar.gameObject))
            {
                _target = null;
                _adjusting = false;
                _offsetsFor = null;
            }

            if (_target != null && !targets.Contains(_target.transform)) targets.Insert(0, _target.transform);

            // つけたアクセの一覧（外す・調整）
            root.Add(BuildAttachedList(ctx, avatar, targets));

            if (_adjusting && _target != null)
            {
                root.Add(BuildAdjuster(ctx, avatar, _target.transform));
            }
            else if (targets.Count > 0)
            {
                root.Add(Ui.Text(L10n.Tr("transform.adjustHint"), "kn-hint"));
            }

            return root;
        }

        public override void OnClosed()
        {
            _baselines.Clear();
            _offsetsFor = null;
        }

        // ---------------------------------------------------------------- つける

        private VisualElement BuildAttach(FeatureContext ctx)
        {
            var box = Ui.Box("kn-attach");
            box.Add(Ui.Heading(L10n.Tr("attach.pick")));

            if (_pending == null)
            {
...
            {
                box.Add(ItemPicker.DropZone(L10n.Tr("attach.drop"), ItemKind.Accessory, prefab =>
                {
                    _pending = prefab;
                    ctx.Rebuild();
                }));

                var suggestions = ItemPicker.Suggestions(ctx.Avatar, ItemKind.Accessory);
                if (suggestions.Count > 0)
                {
                    box.Add(Ui.Text(L10n.Tr("attach.suggest"), "kn-hint"));
                    box.Add(ItemPicker.SuggestionList(suggestions, prefab =>
                    {
                        _pending = prefab;
                        ctx.Rebuild();
                    }));
                }

                box.Add(ItemPicker.OwnedItems(ItemKind.Accessory, prefab =>
                {
                    _pending = prefab;
                    ctx.Rebuild();
                }));
                return box;
            }

            var chosen = Ui.Box("kn-row", "kn-attach__chosen");
            chosen.Add(Ui.Text(L10n.Tr("attach.chosen", _pending.name), "kn-grow"));
            chosen.Add(Ui.Button(L10n.Tr("attach.cancel"), () =>
            {
                _pending = null;
                ctx.Rebuild();
            }, "kn-button--small", "kn-button--ghost"));
            box.Add(chosen);

            box.Add(Ui.Heading(L10n.Tr("attach.where")));
            var labels = new List<string>();
            foreach (var key in PlaceKeys) labels.Add(L10n.Tr(key));
            box.Add(Ui.Chips(labels, _placeIndex, i =>
            {
                _placeIndex = i;
                ctx.Rebuild();
            }));

            box.Add(Ui.Button(L10n.Tr("attach.do"), () => Attach(ctx, _pending, Places[_placeIndex]), "kn-button--primary"));
            return box;
        }

        /// <summary>
        /// アクセを体の骨に付け、付けた直後に調整パネルを開く。
        /// 作ったオブジェクト・親子の変更・位置の補正を 1 つの Undo グループにまとめる。
        /// </summary>
        private void Attach(FeatureContext ctx, GameObject prefab, HumanBodyBones place)
        {
            var avatar = ctx.Avatar;
            var bone = FindBone(avatar, place);
            if (bone == null)
            {
                EditorUtility.DisplayDialog(L10n.Tr("app.name"), L10n.Tr("attach.noBone"), L10n.Tr("dialog.ok"));
                return;
            }

            var undoName = L10n.Tr("undo.attach");
            ctx.BeginEdit();
            UndoHelper.Separate();
            Undo.IncrementCurrentGroup();
            var group = Undo.GetCurrentGroup();
            Undo.SetCurrentGroupName(undoName);

            var instance = PrefabUtility.InstantiatePrefab(prefab) as GameObject;
            if (instance == null) return;
            Undo.RegisterCreatedObjectUndo(instance, undoName);

            PlaceAtBone(avatar, prefab, instance, bone, place, undoName);
            Undo.CollapseUndoOperations(group);
            UndoHelper.Separate();
            ctx.NoteCreated(instance);

            _baselines[instance] = new Baseline
            {
                LocalPosition = instance.transform.localPosition,
                LocalRotation = instance.transform.localRotation,
                LocalScale = instance.transform.localScale,
            };
            _target = instance;
            _adjusting = true;
            _offsetsFor = instance;
            ResetOffsets();
            _pending = null;
            ctx.Rebuild();
            FrameInScene(instance.transform, false);
        }

        private static Transform FindBone(VRCAvatarDescriptor avatar, HumanBodyBones place)
        {
            var animator = avatar.GetComponent<Animator>();
            if (animator == null || !animator.isHuman) return null;
            var bone = animator.GetBoneTransform(place);
            if (bone == null && place == HumanBodyBones.Chest) bone = animator.GetBoneTransform(HumanBodyBones.Spine);
            return bone;
        }

        /// <summary>
        /// 骨の下へ入れる。アバター用に作られたアクセ（名前や元の位置から判断）は元のワールド位置を保ち、
        /// そうでなければ見た目の中心が骨（頭なら頭の上側など）へ来るように置く。
        /// </summary>
        private static void PlaceAtBone(VRCAvatarDescriptor avatar, GameObject prefab, GameObject instance,
            Transform bone, HumanBodyBones place, string undoName)
        {
            var keepWorld = LooksMadeForAvatar(avatar, prefab) || IsOriginalPositionNear(avatar, instance, bone);

            // Undo.SetTransformParent はワールド位置を保ったまま親を変える
            Undo.SetTransformParent(instance.transform, bone, undoName);
            if (keepWorld) return;

            var target = bone.position + PlacementOffset(avatar, place);
            Bounds bounds;
            if (!TryBounds(instance, out bounds))
            {
                Undo.RecordObject(instance.transform, undoName);
                instance.transform.position = target;
                return;
            }

            // 見た目の中心（Renderer の bounds の中心）を付けたい場所へ合わせる
            Undo.RecordObject(instance.transform, undoName);
            instance.transform.position += target - bounds.center;
        }

        /// <summary>頭なら頭の上側、首なら首のまわり、といった簡単な補正。</summary>
        private static Vector3 PlacementOffset(VRCAvatarDescriptor avatar, HumanBodyBones place)
        {
            var height = Mathf.Max(0.5f, AvatarMeasure.Height(avatar));
            var up = avatar.transform.up;
            var forward = avatar.transform.forward;
            switch (place)
            {
                case HumanBodyBones.Head:
                    return up * (height * 0.07f) + forward * (height * 0.005f);
                case HumanBodyBones.Neck:
                    return up * (height * 0.005f);
                case HumanBodyBones.Chest:
                case HumanBodyBones.UpperChest:
                    return up * (height * 0.02f);
                case HumanBodyBones.Hips:
                    return up * (height * 0.03f);
                case HumanBodyBones.RightFoot:
                case HumanBodyBones.LeftFoot:
                    return up * (height * 0.03f);
                default:
                    return Vector3.zero;
            }
        }

        /// <summary>Prefab 名かフォルダ名にアバター名（最初の語）が入っているか。</summary>
        private static bool LooksMadeForAvatar(VRCAvatarDescriptor avatar, GameObject prefab)
        {
            var keywords = new List<string>();
            var name = avatar.name.ToLowerInvariant();
            keywords.Add(name);
            foreach (var part in name.Split(new[] { '_', ' ', '-', '(', '（', '.' }, StringSplitOptions.RemoveEmptyEntries))
            {
                if (part.Length >= 3) keywords.Add(part);
            }

            var haystacks = new List<string> { prefab.name.ToLowerInvariant() };
            var path = AssetDatabase.GetAssetPath(prefab);
            if (!string.IsNullOrEmpty(path)) haystacks.Add(path.ToLowerInvariant());

            foreach (var keyword in keywords.Distinct())
            {
                foreach (var haystack in haystacks)
                {
                    if (haystack.Contains(keyword)) return true;
                }
            }

            return false;
        }

        /// <summary>元の見た目の中心が骨の近く（体の大きさの 20% 以内）にあるか。</summary>
        private static bool IsOriginalPositionNear(VRCAvatarDescriptor avatar, GameObject instance, Transform bone)
        {
            Bounds bounds;
            if (!TryBounds(instance, out bounds)) return false;
            var limit = Mathf.Max(0.15f, AvatarMeasure.Height(avatar) * 0.2f);
            return Vector3.Distance(bounds.center, bone.position) <= limit;
        }

        private static bool TryBounds(GameObject go, out Bounds bounds)
        {
            bounds = new Bounds();
            var found = false;
            foreach (var r in go.GetComponentsInChildren<Renderer>(true))
            {
                if (!found)
                {
                    bounds = r.bounds;
                    found = true;
                }
                else
                {
                    bounds.Encapsulate(r.bounds);
                }
            }

            return found;
        }

