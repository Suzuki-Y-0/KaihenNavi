+private static bool LooksLikeBodyOrHair(string name)
+{
+    var lower = name.ToLowerInvariant();
+    var hair = new[] { "hair", "kami", "bang", "fringe", "ponytail", "twintail", "髪", "前髪", "後ろ髪", "横髪", "アホ毛" };
+    foreach (var word in hair)
+    {
+        if (lower.Contains(word)) return true;
+    }
+
+    // 「headphone」のような小物を肌と間違えないよう、head は単独の名前と区切り付きだけを見る
+    var body = new[] { "body", "skin", "face", "karada", "hada", "kao", "肌", "顔", "素体" };
+    foreach (var word in body)
+    {
+        if (lower.Contains(word)) return true;
+    }
+
+    return lower == "head" || lower.StartsWith("head_") || lower.StartsWith("head.") || lower.Contains("_head") ||
+           lower.Contains(".head");
+}
