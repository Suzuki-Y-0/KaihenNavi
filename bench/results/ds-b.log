        private void UseSelection(FeatureContext ctx, VRCAvatarDescriptor avatar)
        {
            var selected = Selection.activeTransform;
            if (selected == null || selected == avatar.transform || !selected.IsChildOf(avatar.transform))
            {
                EditorUtility.DisplayDialog(L10n.Tr("app.name"), L10n.Tr("transform.selectionInvalid"), L10n.Tr("dialog.ok"));
                return;
            }

            SelectForAdjust(ctx, selected.gameObject);
        }

        private void SelectForAdjust(FeatureContext ctx, GameObject target)
        {
            _target = target;
            _adjusting = true;
            if (_offsetsFor != target)
            {
                _offsetsFor = target;
                ResetOffsets();
            }

            UndoHelper.Separate();
            ctx.Rebuild();
        }

        /// <summary>アクセを外す。削除も Ctrl+Z 1 回で戻せる 1 つの操作にまとめる。</summary>
        private void Remove(FeatureContext ctx, GameObject target)
        {
            if (target == null) return;
            var undoName = L10n.Tr("undo.attachRemove");

            ctx.BeginEdit();
            UndoHelper.Separate();
            Undo.IncrementCurrentGroup();
            var group = Undo.GetCurrentGroup();
            Undo.SetCurrentGroupName(undoName);

            _baselines.Remove(target);
            if (_offsetsFor == target)
            {
                _offsetsFor = null;
                ResetOffsets();
            }

            if (_target == target)
            {
                _target = null;
                _adjusting = false;
            }

            Undo.DestroyObjectImmediate(target);
            Undo.CollapseUndoOperations(group);
            UndoHelper.Separate();
            ctx.Rebuild();
        }

        // ---------------------------------------------------------------- 調整

        private VisualElement BuildAdjuster(FeatureContext ctx, VRCAvatarDescriptor avatar, Transform target)
        {
            var baseline = GetBaseline(target.gameObject);
            if (_offsetsFor != target.gameObject)
            {
                _offsetsFor = target.gameObject;
                ResetOffsets();
            }

            var box = Ui.Box("kn-attach");
            box.Add(Ui.Heading(L10n.Tr("transform.adjusting", target.name)));

            if (target.GetComponent<SkinnedMeshRenderer>() != null && target.childCount == 0)
            {
                box.Add(Ui.Notice(L10n.Tr("transform.skinnedWarn"), "warn"));
            }

            // 位置（付けた骨からの相対。cm 表示）
            box.Add(Ui.Heading(L10n.Tr("transform.position")));
            box.Add(Ui.Text(L10n.Tr("transform.positionHint"), "kn-hint"));
            var range = Mathf.Max(10f, AvatarMeasure.Height(avatar) * 40f);
            box.Add(Ui.Slider(L10n.Tr("transform.upDown"), -range, range, _upCm, v =>
            {
                _upCm = v;
                ApplyPosition(ctx, avatar, target, baseline);
            }));
            box.Add(Ui.Slider(L10n.Tr("transform.frontBack"), -range, range, _forwardCm, v =>
            {
                _forwardCm = v;
                ApplyPosition(ctx, avatar, target, baseline);
            }));
            box.Add(Ui.Slider(L10n.Tr("transform.leftRight"), -range, range, _rightCm, v =>
            {
                _rightCm = v;
                ApplyPosition(ctx, avatar, target, baseline);
            }));

            // 向き
            box.Add(Ui.Heading(L10n.Tr("transform.rotation")));
            box.Add(Ui.Text(L10n.Tr("transform.rotationHint"), "kn-hint"));
            box.Add(Ui.Slider(L10n.Tr("transform.yaw"), -180f, 180f, _yaw, v =>
            {
                _yaw = v;
                ApplyRotation(ctx, avatar, target, baseline);
            }));
            box.Add(Ui.Slider(L10n.Tr("transform.pitch"), -180f, 180f, _pitch, v =>
            {
                _pitch = v;
                ApplyRotation(ctx, avatar, target, baseline);
            }));
            box.Add(Ui.Slider(L10n.Tr("transform.roll"), -180f, 180f, _roll, v =>
            {
                _roll = v;
                ApplyRotation(ctx, avatar, target, baseline);
            }));

            // 大きさ
            box.Add(Ui.Heading(L10n.Tr("transform.size")));
            box.Add(Ui.Text(L10n.Tr("transform.scaleHint"), "kn-hint"));
            var currentPercent = SizePercent(target, baseline);
            _size = Ui.Slider(L10n.Tr("transform.sizeLabel"), 10f, 300f, currentPercent,
                v => Resize(ctx, target, baseline, v));
            box.Add(_size);

            var sizeButtons = Ui.Box("kn-row");
            sizeButtons.Add(Ui.Button("−5%", () => _size.value = Mathf.Clamp(_size.value - 5f, 10f, 300f), "kn-button--small"));
            sizeButtons.Add(Ui.Button("+5%", () => _size.value = Mathf.Clamp(_size.value + 5f, 10f, 300f), "kn-button--small"));
            sizeButtons.Add(Ui.Button("100%", () => _size.value = 100f, "kn-button--small"));
            box.Add(sizeButtons);

            // まとめ
            var actions = Ui.Box("kn-row");
            var sceneMove = Ui.Button(L10n.Tr("transform.sceneMove"), () => FrameInScene(target, true), "kn-button--ghost");
            sceneMove.tooltip = L10n.Tr("transform.sceneMoveTip");
            actions.Add(sceneMove);
            actions.Add(Ui.Button(L10n.Tr("transform.resetEstimate"), () => ResetEstimate(ctx, target, baseline)));
            actions.Add(Ui.Button(L10n.Tr("transform.done"), () =>
            {
                _target = null;
                _adjusting = false;
                UndoHelper.Separate();
                ctx.Rebuild();
            }, "kn-button--primary"));
            box.Add(actions);

            return box;
        }

        private Baseline GetBaseline(GameObject target)
        {
            Baseline baseline;
            if (_baselines.TryGetValue(target, out baseline)) return baseline;

            baseline = new Baseline
            {
                LocalPosition = target.transform.localPosition,
                LocalRotation = target.transform.localRotation,
                LocalScale = target.transform.localScale,
            };
            _baselines[target] = baseline;
            return baseline;
        }

        private void ResetOffsets()
        {
            _upCm = 0f;
            _forwardCm = 0f;
            _rightCm = 0f;
            _yaw = 0f;
            _pitch = 0f;
            _roll = 0f;
        }

        /// <summary>上下・前後・左右のスライダーを、付けた骨からの相対位置に反映する。</summary>
        private void ApplyPosition(FeatureContext ctx, VRCAvatarDescriptor avatar, Transform target, Baseline baseline)
        {
            var undoName = L10n.Tr("undo.transformMove");
            ctx.BeginEdit();
            UndoHelper.Begin("transform-position", undoName);
            Undo.RecordObject(target, undoName);

            var delta = avatar.transform.up * (_upCm / 100f) +
                        avatar.transform.forward * (_forwardCm / 100f) +
                        avatar.transform.right * (_rightCm / 100f);
            target.localPosition = baseline.LocalPosition + target.parent.InverseTransformVector(delta);
            UndoHelper.End();
        }

        /// <summary>3 軸の回転スライダーを、付けたときの向きからの角度として反映する。</summary>
        private void ApplyRotation(FeatureContext ctx, VRCAvatarDescriptor avatar, Transform target, Baseline baseline)
        {
            var undoName = L10n.Tr("undo.transformRotate");
            ctx.BeginEdit();
            UndoHelper.Begin("transform-rotation", undoName);
            Undo.RecordObject(target, undoName);

            var baseWorld = target.parent.rotation * baseline.LocalRotation;
            target.rotation = Quaternion.AngleAxis(_yaw, avatar.transform.up) *
                              Quaternion.AngleAxis(_pitch, avatar.transform.right) *
                              Quaternion.AngleAxis(_roll, avatar.transform.forward) *
                              baseWorld;
            UndoHelper.End();
        }

        private static void Resize(FeatureContext ctx, Transform target, Baseline baseline, float percent)
        {
            var undoName = L10n.Tr("undo.transformScale");
            ctx.BeginEdit();
            UndoHelper.Begin("transform-scale", undoName);
            Undo.RecordObject(target, undoName);
            target.localScale = baseline.LocalScale * (percent / 100f);
            UndoHelper.End();
        }

        private static float SizePercent(Transform target, Baseline baseline)
        {
            var b = baseline.LocalScale;
            var c = target.localScale;
            var reference = Mathf.Abs(b.x) > 1e-6f ? b.x : (Mathf.Abs(b.y) > 1e-6f ? b.y : b.z);
            var current = Mathf.Abs(b.x) > 1e-6f ? c.x : (Mathf.Abs(b.y) > 1e-6f ? c.y : c.z);
            if (Mathf.Abs(reference) < 1e-6f) return 100f;
            return Mathf.Clamp(current / reference * 100f, 10f, 300f);
        }

        private void ResetEstimate(FeatureContext ctx, Transform target, Baseline baseline)
        {
            var undoName = L10n.Tr("undo.transformReset");
            ctx.BeginEdit();
            UndoHelper.Separate();
            Undo.IncrementCurrentGroup();
            var group = Undo.GetCurrentGroup();
            Undo.SetCurrentGroupName(undoName);

            Undo.RecordObject(target, undoName);
            target.localPosition = baseline.LocalPosition;
            target.localRotation = baseline.LocalRotation;
            target.localScale = baseline.LocalScale;

            Undo.CollapseUndoOperations(group);
            UndoHelper.Separate();
            ResetOffsets();
            ctx.Rebuild();
        }

