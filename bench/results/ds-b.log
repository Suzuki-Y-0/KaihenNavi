+private static ToggleVisibilityData ReadVisibility(VRCAvatarDescriptor avatar)
+{
+    var path = VisibilityPath(avatar);
+    if (!File.Exists(path)) return null;
+    try
+    {
+        return JsonUtility.FromJson<ToggleVisibilityData>(File.ReadAllText(path, Encoding.UTF8));
+    }
+    catch (System.Exception)
+    {
+        return null;
+    }
+}
+
+/// <summary>メニューを作る前の表示状態に戻す。記録が無い古いメニューは MA の初期値で戻す。</summary>
+private static void RestoreVisibility(VRCAvatarDescriptor avatar, string undoName)
+{
+    var data = ReadVisibility(avatar);
+    if (data != null && data.items != null)
+    {
+        foreach (var entry in data.items)
+        {
+            if (entry == null) continue;
+            var t = HierarchyPath.Find(avatar.transform, entry.path);
+            if (t == null || t.gameObject.activeSelf == entry.active) continue;
+            Undo.RecordObject(t.gameObject, undoName);
+            t.gameObject.SetActive(entry.active);
+            EditorUtility.SetDirty(t.gameObject);
+        }
+
+        return;
+    }
+
+    foreach (var e in ReadExisting(avatar))
+    {
+        if (e.Target.activeSelf == e.IsDefault) continue;
+        Undo.RecordObject(e.Target, undoName);
+        e.Target.SetActive(e.IsDefault);
+        EditorUtility.SetDirty(e.Target);
+    }
+}
