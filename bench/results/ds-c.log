        private void ShowHistoryPopover()
        {
            if (_avatar == null || _historyButton == null) return;
            HideHistoryPopover();

            var popover = Ui.Box("kn-popover");
            _historyPopover = popover;
            rootVisualElement.Add(popover);

            var header = Ui.Box("kn-popover__header");
            header.Add(Ui.Text(L10n.Tr("history.title"), "kn-popover__title"));
            header.Add(Ui.Button(L10n.Tr("history.close"), HideHistoryPopover, "kn-button--small", "kn-button--ghost"));
            popover.Add(header);

            var scroll = new ScrollView(ScrollViewMode.Vertical);
            scroll.AddToClassList("kn-popover__scroll");
            _historyContent = Ui.Box("kn-popover__content");
            scroll.Add(_historyContent);
            popover.Add(scroll);

            var bounds = _historyButton.worldBound;
            var rootBounds = rootVisualElement.worldBound;
            var width = 320f;
            popover.style.left = Mathf.Max(8f, Mathf.Min(bounds.xMax - rootBounds.x - width, rootBounds.width - width - 8f));
            popover.style.top = bounds.yMax - rootBounds.y + 4f;

            FillHistoryPopover();
            rootVisualElement.RegisterCallback<PointerDownEvent>(OnHistoryPointerDown, TrickleDown.TrickleDown);
            rootVisualElement.RegisterCallback<KeyDownEvent>(OnHistoryKeyDown, TrickleDown.TrickleDown);
        }

        private void HideHistoryPopover()
        {
            rootVisualElement.UnregisterCallback<PointerDownEvent>(OnHistoryPointerDown, TrickleDown.TrickleDown);
            rootVisualElement.UnregisterCallback<KeyDownEvent>(OnHistoryKeyDown, TrickleDown.TrickleDown);
            if (_historyPopover != null) _historyPopover.RemoveFromHierarchy();
            _historyPopover = null;
            _historyContent = null;
        }

        private void OnHistoryPointerDown(PointerDownEvent e)
        {
            if (_historyPopover == null) return;
            var target = e.target as VisualElement;
            for (var element = target; element != null; element = element.parent)
            {
                if (element == _historyPopover || element == _historyButton) return;
            }

            HideHistoryPopover();
        }

        private void OnHistoryKeyDown(KeyDownEvent e)
        {
            if (e.keyCode != KeyCode.Escape) return;
            HideHistoryPopover();
            e.StopPropagation();
        }

        /// <summary>
        /// 1 段目は自動バックアップのまとまり（機能・時刻）、2 段目は Undo の 1 手順。
        /// まとまりの時刻から次のまとまりまでを、そのまとまりの手順として並べる。
        /// </summary>
        private void FillHistoryPopover()
        {
            if (_historyContent == null || _avatar == null) return;
            _historyContent.Clear();

            var snapshots = _backup.List(_avatar);
            var steps = UndoHistory.List(BackupService.AvatarId(_avatar));
            if (snapshots.Count == 0)
            {
                _historyContent.Add(Ui.Text(L10n.Tr("history.empty"), "kn-history__empty"));
                return;
            }

            var bySnapshot = new Dictionary<long, List<UndoHistory.Step>>();
            foreach (var step in steps)
            {
                BackupSnapshot owner = null;
                foreach (var snapshot in snapshots)
                {
                    if (step.Time < snapshot.CreatedAt) continue;
                    owner = snapshot;
                    break;
                }

                if (owner == null) continue;
                List<UndoHistory.Step> list;
                if (!bySnapshot.TryGetValue(owner.createdTicks, out list))
                {
                    list = new List<UndoHistory.Step>();
                    bySnapshot[owner.createdTicks] = list;
                }

                list.Add(step);
            }

            var expandedStillExists = false;
            foreach (var snapshot in snapshots)
            {
                List<UndoHistory.Step> groupSteps;
                if (!bySnapshot.TryGetValue(snapshot.createdTicks, out groupSteps)) groupSteps = new List<UndoHistory.Step>();
                if (snapshot.createdTicks == _historyExpanded) expandedStillExists = true;
                _historyContent.Add(BuildHistoryGroup(snapshot, groupSteps));
            }

            if (!expandedStillExists) _historyExpanded = long.MinValue;
        }

        private VisualElement BuildHistoryGroup(BackupSnapshot snapshot, List<UndoHistory.Step> steps)
        {
            var expanded = snapshot.createdTicks == _historyExpanded;
            var group = Ui.Box("kn-history__group-wrap");

            var row = new Button(() =>
                {
                    _historyExpanded = expanded ? long.MinValue : snapshot.createdTicks;
                    FillHistoryPopover();
                });
            row.AddToClassList("kn-history__group");
            var texts = Ui.Box("kn-history__texts");
            texts.Add(Ui.Text(FeatureTitle(snapshot.featureId), "kn-history__title"));
            texts.Add(Ui.Text(L10n.Tr("history.groupMeta", snapshot.CreatedAt.ToString("M/d HH:mm"), steps.Count), "kn-history__meta"));
            row.Add(texts);
            row.Add(Ui.Text(expanded ? "▾" : "▸", "kn-history__chevron"));
            group.Add(row);

            if (!expanded) return group;
            var list = Ui.Box("kn-history__steps");
            if (steps.Count == 0)
            {
                var empty = Ui.Box("kn-history__empty-row");
                empty.Add(Ui.Text(L10n.Tr("history.noSteps"), "kn-history__meta"));
                empty.Add(Ui.Button(L10n.Tr("history.restoreGroup"), () => RestoreFromHistory(snapshot),
                    "kn-button--small", "kn-button--ghost"));
                list.Add(empty);
            }
            else
            {
                foreach (var step in steps)
                {
                    var rowStep = step;
                    var item = Ui.Box("kn-history__step");
                    var stepTexts = Ui.Box("kn-history__texts");
                    stepTexts.Add(Ui.Text(HistoryNames.Describe(rowStep.Name), "kn-history__title"));
                    stepTexts.Add(Ui.Text(rowStep.Time.ToString("M/d HH:mm:ss"), "kn-history__meta"));
                    item.Add(stepTexts);
                    item.Add(Ui.Button(L10n.Tr("history.restoreHere"), () => RestoreToStep(rowStep, snapshot),
                        "kn-button--small", "kn-button--ghost", "kn-history__restore"));
                    list.Add(item);
                }
            }

            group.Add(list);
            return group;
        }

        /// <summary>
        /// 1 手順の前に戻す。Undo に残っている手順は Undo で、残っていなければ
        /// そのまとまりのバックアップから戻す（バックアップの設計と食い違わないようにする）。
        /// </summary>
        private void RestoreToStep(UndoHistory.Step step, BackupSnapshot owner)
        {
            if (_avatar == null) return;
            var undoable = step.Group >= 0 && step.Group <= Undo.GetCurrentGroup();
            if (!undoable)
            {
                if (owner == null)
                {
                    EditorUtility.DisplayDialog(L10n.Tr("app.name"), L10n.Tr("history.unavailable"), L10n.Tr("dialog.ok"));
                    return;
                }

                RestoreFromHistory(owner);
                return;
            }

            if (!EditorUtility.DisplayDialog(
                    L10n.Tr("restore.title"),
                    L10n.Tr("history.restoreStepMessage", HistoryNames.Describe(step.Name), step.Time.ToString("M/d HH:mm:ss")),
                    L10n.Tr("restore.ok"),
                    L10n.Tr("dialog.cancel")))
            {
                return;
            }

            if (_selected != null) _selected.OnClosed();
            HideHistoryPopover();
            _backup.EndSession();
            Undo.RevertAllDownToGroup(step.Group);
            UndoHistory.ForgetFrom(step.AvatarId, step.Group);
            // 戻した先より新しいまとまりのバックアップは、今の状態より先のものになるので使わない
            if (owner != null) _backup.DiscardNewer(_avatar, owner);
            UndoHelper.Separate();
            BuildNavigation();
            BuildPanel();
            RefreshFooter();
        }

        private void RestoreFromHistory(BackupSnapshot snapshot)
        {
            if (!EditorUtility.DisplayDialog(
                    L10n.Tr("restore.title"),
                    L10n.Tr("restore.historyMessage", snapshot.CreatedAt.ToString("M/d HH:mm:ss"), FeatureTitle(snapshot.featureId)),
                    L10n.Tr("restore.ok"),
                    L10n.Tr("dialog.cancel")))
            {
                return;
            }

            if (_selected != null) _selected.OnClosed();
            HideHistoryPopover();
            _backup.Restore(_avatar, snapshot);
            UndoHistory.Clear(_avatarId);
            BuildNavigation();
            BuildPanel();
            RefreshFooter();
        }
