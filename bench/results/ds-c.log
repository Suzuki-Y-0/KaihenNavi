+/// <summary>
+/// 履歴の 1 手（Undo グループ）を、いまのまとまりに書き足す。
+/// まとまり（BeginEdit で取ったバックアップ）が無いときは記録しない。
+/// </summary>
+public void RecordStep(VRCAvatarDescriptor avatar, string featureId, string undoName, int undoGroup, string session)
+{
+    if (avatar == null || _current == null || string.IsNullOrEmpty(undoName)) return;
+    if (!SameAvatar(_current, AvatarId(avatar), avatar.name)) return;
+
+    if (_current.steps == null) _current.steps = new List<BackupSnapshot.StepState>();
+    _current.steps.Add(new BackupSnapshot.StepState
+    {
+        ticks = DateTime.Now.Ticks,
+        featureId = string.IsNullOrEmpty(featureId) ? _current.featureId : featureId,
+        undoName = undoName,
+        undoGroup = undoGroup,
+        undoSession = session,
+    });
+    EditorUtility.SetDirty(_current);
+    AssetDatabase.SaveAssetIfDirty(_current);
+}
+
+/// <summary>指定の時刻以降の手順を、このアバターの履歴から消す（Undo で戻したとき）。</summary>
+public void ForgetStepsFrom(VRCAvatarDescriptor avatar, long ticks)
+{
+    foreach (var snapshot in List(avatar))
+    {
+        if (snapshot.steps == null) continue;
+        var removed = snapshot.steps.RemoveAll(s => s != null && s.ticks >= ticks);
+        if (removed == 0) continue;
+        EditorUtility.SetDirty(snapshot);
+        AssetDatabase.SaveAssetIfDirty(snapshot);
+    }
+}
