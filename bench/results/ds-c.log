using System;
using System.Collections.Generic;
using UnityEditor;
using VRC.SDK3.Avatars.Components;

namespace Jeni.KaihenNavi
{
    /// <summary>
    /// 履歴の細かい手順（Undo グループ）を拾って、バックアップのまとまりに書き足す。
    /// 機能はそれぞれ Undo.SetCurrentGroupName で名前を付けているので、
    /// その名前が変わったタイミングを 1 つずつ見張る。
    /// 手順名を表示用に整えるのは HistoryNames が行う。
    /// </summary>
    internal sealed class HistoryService
    {
        private readonly BackupService _backup;
        private int _lastGroup;
        private string _session;
        private bool _primed;

        public HistoryService(BackupService backup)
        {
            _backup = backup;
            _session = NewSession();
            _lastGroup = Undo.GetCurrentGroup();
        }

        /// <summary>
        /// エディタの更新ごとに呼ぶ。Undo のグループが増えたら、その名前を 1 手として記録する。
        /// 1 フレームに何度も呼ばれるが、グループ番号が変わったとき以外は何もしない。
        /// </summary>
        public void Tick(VRCAvatarDescriptor avatar, string featureId)
        {
            var group = Undo.GetCurrentGroup();
            if (!_primed)
            {
                _primed = true;
                _lastGroup = group;
                return;
            }

            if (group == _lastGroup) return;
            var previous = _lastGroup;
            _lastGroup = group;

            // Ctrl+Z で戻ったときは手順を増やさない（やり直しも同じ）
            if (group < previous) return;

            var name = Undo.GetCurrentGroupName();
            if (string.IsNullOrEmpty(name) || !HistoryNames.IsKnown(name)) return;
            _backup.RecordStep(avatar, featureId, name, group, _session);
        }

        /// <summary>この手順を、いまの Undo 履歴で正確に戻せるか。</summary>
        public bool CanUndo(BackupSnapshot.StepState step)
        {
            return step != null && step.undoSession == _session && step.undoGroup >= 0 &&
                   Undo.GetCurrentGroup() >= step.undoGroup;
        }

        /// <summary>
        /// 指定の手順の前まで戻す。
        /// いまの編集セッションの手順は Undo で正確に戻し、それより前（再読み込み後など）は
        /// その手順を含むまとまりのバックアップから戻す。
        /// </summary>
        /// <returns>Undo で戻したとき true、バックアップから戻したとき false。</returns>
        public bool Restore(VRCAvatarDescriptor avatar, BackupSnapshot owner, BackupSnapshot.StepState step)
        {
            if (avatar == null || step == null) return false;

            if (CanUndo(step))
            {
                Undo.RevertAllDownToGroup(step.undoGroup);
                // 戻した手順より後の手順は、もう存在しないので履歴からも消す
                _backup.ForgetStepsFrom(avatar, step.ticks);
                UndoHelper.Separate();
                _lastGroup = Undo.GetCurrentGroup();
                _primed = true;
                return true;
            }

            if (owner != null) _backup.Restore(avatar, owner);
            AfterExternalRestore();
            return false;
        }

        /// <summary>バックアップから戻したあと。それより前の手順は Undo では戻せなくなる。</summary>
        public void AfterExternalRestore()
        {
            _session = NewSession();
            _lastGroup = Undo.GetCurrentGroup();
            _primed = true;
        }

        /// <summary>Ctrl+Z / Ctrl+Y のあと。手順として記録しないよう、今のグループに合わせる。</summary>
        public void AfterUndoRedo()
        {
            _lastGroup = Undo.GetCurrentGroup();
            _primed = true;
        }

        private static string NewSession()
        {
            return Guid.NewGuid().ToString("N");
        }
    }

    /// <summary>
    /// Undo グループ名を、いまの言語の分かりやすい手順名に直す。
    /// 英語や中国語・韓国語で付いた名前も、言語ファイルの対訳から引いて日本語（いまの言語）にそろえる。
    /// 見つからない名前は、その機能のナビ名＋「の操作」にする。
    /// </summary>
    internal static class HistoryNames
    {
        private static Dictionary<string, string> _keys;

        /// <summary>かいへんナビの手順名か（他のツールの Undo を履歴に混ぜないため）。</summary>
        public static bool IsKnown(string name)
        {
            return KeyOf(name) != null;
        }

        /// <summary>画面に出す手順名。raw が空・英語だけのときも、分かりやすい名前にする。</summary>
        public static string Friendly(string raw, string featureId)
        {
            var text = (raw ?? "").Trim();
            var key = KeyOf(text);
            if (key != null) return StripPrefix(L10n.Tr(key));
            if (HasCjk(text)) return StripPrefix(text);

            var title = FeatureTitle(featureId);
            return title == null ? L10n.Tr("history.stepFallback") : L10n.Tr("history.stepOther", title);
        }

        private static string KeyOf(string name)
        {
            var text = (name ?? "").Trim();
            if (text.Length == 0) return null;
            EnsureKeys();
            string key;
            return _keys.TryGetValue(text, out key) ? key : null;
        }

        /// <summary>言語ファイルの値から、手順名のキーを引ける表を作る。</summary>
        private static void EnsureKeys()
        {
            if (_keys != null) return;
            _keys = new Dictionary<string, string>();
            foreach (var code in L10n.Codes)
            {
                foreach (var pair in L10n.Table(code))
                {
                    if (!IsActionKey(pair.Key)) continue;
                    var value = (pair.Value ?? "").Trim();
                    if (value.Length > 0 && !_keys.ContainsKey(value)) _keys[value] = pair.Key;
                }
            }
        }

        private static bool IsActionKey(string key)
        {
            return key.StartsWith("undo.", StringComparison.Ordinal) ||
                   key == "kono.selectProduct";
        }

        private static string FeatureTitle(string featureId)
        {
            if (string.IsNullOrEmpty(featureId)) return null;
            var key = "feature." + featureId + ".nav";
            var title = L10n.Tr(key);
            if (title == key) title = L10n.Tr("feature." + featureId + ".title");
            return title == key ? null : title;
        }

        private static bool HasCjk(string text)
        {
            foreach (var c in text)
            {
                if (c >= 0x2E80) return true;
            }

            return false;
        }

        /// <summary>「かいへんナビ: 」などの前置きを消す（手順名だけを見せる）。</summary>
        private static string StripPrefix(string text)
        {
            var index = text.IndexOf(": ", StringComparison.Ordinal);
            var wide = text.IndexOf('：');
            if (wide >= 0 && (index < 0 || wide < index)) index = wide;
            if (index < 0 || index > 24) return text;
            return text.Substring(index + 1).Trim();
        }
    }
}
