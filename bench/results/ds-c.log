+/// <summary>
+/// 表示中の文言から、対応するキーを探す（履歴の手順名を言語に合わせ直すため）。
+/// 見つからなければ null。
+/// </summary>
+public static string FindKey(string prefix, string value)
+{
+    if (string.IsNullOrEmpty(value)) return null;
+    EnsureLoaded();
+    var key = FindIn(_table, prefix, value);
+    if (key != null) return key;
+    return FindIn(_fallback, prefix, value);
+}
+
+/// <summary>
+/// ほかの言語で保存された文言からもキーを探す。古い履歴を今の言語で表示するために使う。
+/// </summary>
+public static string FindKeyAnywhere(string prefix, string value)
+{
+    var key = FindKey(prefix, value);
+    if (key != null) return key;
+    foreach (var code in Codes)
+    {
+        var table = Load(code);
+        key = FindIn(table, prefix, value);
+        if (key != null) return key;
+    }
+
+    return null;
+}
+
+private static string FindIn(Dictionary<string, string> table, string prefix, string value)
+{
+    if (table == null) return null;
+    foreach (var pair in table)
+    {
+        if (pair.Value == value && (string.IsNullOrEmpty(prefix) || pair.Key.StartsWith(prefix)))
+            return pair.Key;
+    }
+
+    return null;
+}
