        private void ToggleHistory()
        {
            if (_historyOverlay != null) HideHistory();
            else ShowHistory();
        }

        private void ShowHistory()
        {
            if (_avatar == null) return;
            HideHistory();

            var root = rootVisualElement;
            var backdrop = Ui.Box("kn-popover-backdrop");
            backdrop.RegisterCallback<PointerDownEvent>(e =>
            {
                HideHistory();
                e.StopPropagation();
            });

            var panel = Ui.Box("kn-popover");
            panel.RegisterCallback<PointerDownEvent>(e => e.StopPropagation());

            var header = Ui.Box("kn-popover__header");
            header.Add(Ui.Text(L10n.Tr("history.title"), "kn-popover__title"));
            var close = Ui.Button("×", HideHistory, "kn-button--small", "kn-button--ghost", "kn-popover__close");
            close.tooltip = L10n.Tr("history.close");
            header.Add(close);
            panel.Add(header);

            var list = new ScrollView(ScrollViewMode.Vertical);
            list.AddToClassList("kn-popover__scroll");
            _historyList = list;
            BuildHistory(list);
            panel.Add(list);

            root.Add(backdrop);
            root.Add(panel);
            _historyOverlay = backdrop;
            _historyPanel = panel;
            FontLoader.Flush(panel);
        }

        private void HideHistory()
        {
            if (_historyOverlay != null) _historyOverlay.RemoveFromHierarchy();
            if (_historyPanel != null) _historyPanel.RemoveFromHierarchy();
            _historyOverlay = null;
            _historyPanel = null;
            _historyList = null;
        }

        /// <summary>
        /// 1 段目は自動バックアップ（作業のまとまり）、2 段目はその中の Undo グループ（細かい手順）。
        /// まとまりは新しい順、手順も新しい順に並べる。
        /// </summary>
        private void BuildHistory(VisualElement list)
        {
            list.Clear();
            if (_avatar == null) return;
            var groups = _backup.List(_avatar);
            if (groups.Count == 0)
            {
                list.Add(Ui.Text(L10n.Tr("history.empty"), "kn-hint"));
                return;
            }

            foreach (var snapshot in groups)
            {
                var steps = (snapshot.steps ?? new List<BackupSnapshot.StepState>())
                    .Where(s => s != null).OrderByDescending(s => s.ticks).ToList();
                var expanded = _expandedHistory.Contains(snapshot.createdTicks);

                var group = Ui.Box("kn-history__group");
                var header = new Button(() => ToggleHistoryGroup(snapshot.createdTicks));
                header.AddToClassList("kn-history__group-header");
                var featureId = steps.Count > 0 ? steps[0].featureId : snapshot.featureId;
                header.Add(Ui.Text(string.IsNullOrEmpty(featureId) ? L10n.Tr("history.stepFallback") :
                    FeatureNavTitle(featureId), "kn-history__group-title"));
                header.Add(Ui.Text(L10n.Tr("history.steps", steps.Count), "kn-history__group-count"));
                header.Add(Ui.Text(snapshot.CreatedAt.ToString("M/d HH:mm"), "kn-history__time"));
                group.Add(header);

                if (expanded) BuildHistorySteps(group, snapshot, steps);
                list.Add(group);
            }
        }

        private void BuildHistorySteps(VisualElement group, BackupSnapshot snapshot, List<BackupSnapshot.StepState> steps)
        {
            if (steps.Count == 0)
            {
                // この変更より前に取ったバックアップには、細かい手順が残っていない
                var row = Ui.Box("kn-history__step");
                var texts = Ui.Box("kn-history__step-texts");
                texts.Add(Ui.Text(L10n.Tr("history.noSteps"), "kn-history__step-name"));
                row.Add(texts);
                row.Add(Ui.Button(L10n.Tr("history.restoreGroup"), () => RestoreFromHistory(snapshot),
                    "kn-button--small", "kn-button--ghost"));
                group.Add(row);
                return;
            }

            if (steps.Any(s => _history == null || !_history.CanUndo(s)))
                group.Add(Ui.Text(L10n.Tr("history.oldHint"), "kn-hint"));

            foreach (var step in steps)
            {
                var s = step;
                var row = Ui.Box("kn-history__step");
                var texts = Ui.Box("kn-history__step-texts");
                texts.Add(Ui.Text(HistoryNames.Friendly(s.undoName, s.featureId), "kn-history__step-name"));
                texts.Add(Ui.Text(new System.DateTime(s.ticks, System.DateTimeKind.Local).ToString("M/d HH:mm:ss"),
                    "kn-history__time"));
                row.Add(texts);

                var restore = Ui.Button(L10n.Tr("history.restoreStep"), () => RestoreStepFromHistory(snapshot, s),
                    "kn-button--small", "kn-button--ghost");
                if (_history == null || !_history.CanUndo(s)) restore.tooltip = L10n.Tr("history.oldRestoreTip");
                row.Add(restore);
                group.Add(row);
            }
        }

        private void ToggleHistoryGroup(long ticks)
        {
            if (!_expandedHistory.Add(ticks)) _expandedHistory.Remove(ticks);
            if (_historyList != null) BuildHistory(_historyList);
        }

        private void RestoreStepFromHistory(BackupSnapshot owner, BackupSnapshot.StepState step)
        {
            if (_avatar == null || _history == null || step == null) return;
            var undoable = _history.CanUndo(step);
            var name = HistoryNames.Friendly(step.undoName, step.featureId);
            var message = undoable
                ? L10n.Tr("history.restoreStepMessage", name)
                : L10n.Tr("history.restoreOldMessage", name, owner.CreatedAt.ToString("M/d HH:mm"));
            if (!EditorUtility.DisplayDialog(L10n.Tr("history.title"), message,
                    L10n.Tr("history.restoreStep"), L10n.Tr("dialog.cancel")))
            {
                return;
            }

            if (_selected != null) _selected.OnClosed();
            _restoringHistory = true;
            try
            {
                _history.Restore(_avatar, owner, step);
            }
            finally
            {
                _restoringHistory = false;
            }
