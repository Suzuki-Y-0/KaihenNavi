        /// 指定したバックアップより新しいもの（今の状態より先の状態）を消す。
        /// 履歴から Undo で手順を戻したとき、残っているバックアップと食い違わないようにする。
        /// </summary>
        public void DiscardNewer(VRCAvatarDescriptor avatar, BackupSnapshot keep)
        {
            if (avatar == null || keep == null) return;
            var newer = List(avatar).Where(s => s.createdTicks > keep.createdTicks).ToList();
            if (newer.Count == 0) return;
            foreach (var snapshot in newer) AssetDatabase.DeleteAsset(AssetDatabase.GetAssetPath(snapshot));
            AssetDatabase.SaveAssets();
            RaiseChanged();
        }

