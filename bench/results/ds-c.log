        public static string BlueprintId(GameObject avatar)
        {
            var pm = avatar == null ? null : avatar.GetComponent<PipelineManager>();
            return pm == null || string.IsNullOrEmpty(pm.blueprintId) ? "" : pm.blueprintId;
        }

        /// <summary>ID を外す（次のアップロードで新しいアバターになる）。外したら true。</summary>
        public static bool ClearBlueprintId(GameObject avatar)
        {
            var pm = avatar == null ? null : avatar.GetComponent<PipelineManager>();
            if (pm == null || string.IsNullOrEmpty(pm.blueprintId)) return false;
            Undo.RecordObject(pm, "KaihenNavi");
            pm.blueprintId = "";
            EditorUtility.SetDirty(pm);
            return true;
        }

        /// <summary>同じアップロード先を使っている、ほかの改変アバター（上書き事故の元）。</summary>
        public static List<GameObject> SameUploadTarget(VRCAvatarDescriptor avatar)
        {
            var result = new List<GameObject>();
            var id = BlueprintId(avatar.gameObject);
            if (id.Length == 0) return result;
            try
            {
                // 常にディスクから読み、古い表示の台帳で新しい取り込みを上書きしない。
                var packages = ReadPackages();
                var key = LinkKey(package);
                var current = packages.FirstOrDefault(p => p != null && LinkKey(p) == key);
                if (current == null) return;
                KonoAssetLedgerLinkUndo state;
                if (!LinkUndo.TryGetValue(key, out state))
                {
                    state = ScriptableObject.CreateInstance<KonoAssetLedgerLinkUndo>();
                    state.hideFlags = HideFlags.HideAndDontSave;
                    LinkUndo[key] = state;
                }
                state.itemId = current.konoAssetId;
                state.manual = current.konoAssetManual;
                Undo.IncrementCurrentGroup();
                Undo.SetCurrentGroupName(L10n.Tr("kono.selectProduct"));
                Undo.RecordObject(state, L10n.Tr("kono.selectProduct"));
                state.itemId = item == null ? null : item.id;
                state.manual = true;
                current.konoAssetId = state.itemId;
                current.konoAssetManual = true;
                Save(packages);
            }
            catch (Exception e) { Warn(e); }
        }

