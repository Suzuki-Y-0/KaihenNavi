+        public void DiscardNewer(VRCAvatarDescriptor avatar, BackupSnapshot keep)
+        {
+            if (avatar == null || keep == null) return;
+            var newer = List(avatar).Where(s => s.createdTicks > keep.createdTicks).ToList();
