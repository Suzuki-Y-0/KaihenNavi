/* 履歴ポップオーバー。右の帯の下に重ね、1 段目＝まとまり、2 段目＝細かい手順。 */
.kn-popover-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.08);
}
.kn-popover {
    position: absolute;
    top: 64px;
    right: 16px;
    width: 340px;
    max-width: 92%;
    max-height: 70%;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--kn-border);
    border-radius: 6px;
    background-color: var(--kn-surface);
}
.kn-popover__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 8px 8px 8px 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--kn-border);
}
.kn-popover__title { flex-grow: 1; font-size: 12px; -unity-font-style: bold; margin: 0; }
.kn-popover__close { width: 24px; min-width: 24px; margin: 0; padding: 0; }
.kn-popover__scroll { flex-grow: 1; min-height: 0; }
.kn-popover__scroll .unity-scroll-view__content-container { padding: 6px 8px 10px 8px; }
.kn-history__group { margin: 2px 0; }
.kn-history__group-header {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 8px;
    border-width: 0;
    border-radius: 4px;
    background-color: transparent;
    color: var(--kn-text);
    -unity-text-align: middle-left;
}
.kn-history__group-header:hover { background-color: var(--kn-surface-hover); }
.kn-history__group-title { flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; }
.kn-history__group-count {
    flex-shrink: 0;
    min-width: 18px;
    height: 16px;
    font-size: 10px;
    color: var(--kn-text-sub);
    background-color: var(--kn-badge-bg);
    border-radius: 8px;
    padding: 0 5px;
    margin: 0 8px 0 4px;
    -unity-text-align: middle-center;
}
.kn-history__time { flex-shrink: 0; font-size: 10.5px; color: var(--kn-text-faint); margin: 0; }
.kn-history__step {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    margin-left: 8px;
    padding: 2px 4px 2px 10px;
    border-left-width: 2px;
    border-left-color: var(--kn-border);
}
.kn-history__step-texts { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.kn-history__step-name { font-size: 11px; white-space: normal; margin: 0; }
.kn-history__step .kn-button { flex-shrink: 0; margin: 0 0 0 6px; }
.kn-compact-window .kn-popover { left: 12px; right: 12px; width: auto; max-width: none; }
EOF
