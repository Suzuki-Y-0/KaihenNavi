        private static VisualElement BuildAttach(FeatureContext ctx)
        {
            var box = Ui.Box("kn-attach");
            box.Add(Ui.Heading(L10n.Tr("attach.pick")));

            if (_pending == null)
            {
                box.Add(ItemPicker.DropZone(L10n.Tr("attach.drop"), ItemKind.Accessory, prefab =>
                {
                    _pending = prefab;
                    ctx.Rebuild();
                }));

                var suggestions = ItemPicker.Suggestions(ctx.Avatar, ItemKind.Accessory);
                if (suggestions.Count > 0)
                {
                    box.Add(Ui.Text(L10n.Tr("attach.suggest"), "kn-hint"));
                    box.Add(ItemPicker.SuggestionList(suggestions, prefab =>
                    {
                        _pending = prefab;
                        ctx.Rebuild();
                    }));
                }

                box.Add(ItemPicker.OwnedItems(ItemKind.Accessory, prefab =>
                {
                    _pending = prefab;
                    ctx.Rebuild();
                }));
                return box;
            }

            var chosen = Ui.Box("kn-row", "kn-attach__chosen");
            chosen.Add(Ui.Text(L10n.Tr("attach.chosen", _pending.name), "kn-grow"));
            chosen.Add(Ui.Button(L10n.Tr("attach.cancel"), () =>
            {
                _pending = null;
                ctx.Rebuild();
            }, "kn-button--small", "kn-button--ghost"));
            box.Add(chosen);

            box.Add(Ui.Heading(L10n.Tr("attach.where")));
            var labels = new List<string>();
            foreach (var key in PlaceKeys) labels.Add(L10n.Tr(key));
            box.Add(Ui.Chips(labels, _placeIndex, i =>
            {
                _placeIndex = i;
                ctx.Rebuild();
            }));

            box.Add(Ui.Button(L10n.Tr("attach.do"), () => Attach(ctx, _pending, Places[_placeIndex]), "kn-button--primary"));
            return box;
        }

        /// <summary>
        /// アクセを体の骨に付ける。まずアバターの足元を基準に置き（アバター用に作られたアクセはこれで正しい位置になる）、
        /// 見た目が付ける場所から大きく離れていれば、その場所へ寄せる。
        /// </summary>
        private static void Attach(FeatureContext ctx, GameObject prefab, HumanBodyBones place)
        {
            var avatar = ctx.Avatar;
            var animator = avatar.GetComponent<Animator>();
            var bone = animator != null && animator.isHuman ? animator.GetBoneTransform(place) : null;
            if (bone == null && place == HumanBodyBones.Chest && animator != null && animator.isHuman) bone = animator.GetBoneTransform(HumanBodyBones.Spine);
            if (bone == null)
            {
                EditorUtility.DisplayDialog(L10n.Tr("app.name"), L10n.Tr("attach.noBone"), L10n.Tr("dialog.ok"));
                return;
            }

            var undoName = L10n.Tr("undo.attach");
            ctx.BeginEdit();
            UndoHelper.Separate();

            var instance = PrefabUtility.InstantiatePrefab(prefab) as GameObject;
            if (instance == null) return;
            Undo.RegisterCreatedObjectUndo(instance, undoName);
            instance.transform.SetParent(avatar.transform, false);
            Undo.SetTransformParent(instance.transform, bone, undoName);

            Bounds bounds;
            if (TryBounds(instance, out bounds))
            {
                var limit = Mathf.Max(0.25f, avatar.ViewPosition.y * 0.25f);
                if (Vector3.Distance(bounds.center, bone.position) > limit)
                {
                    instance.transform.position += bone.position - bounds.center;
                }
            }

            ctx.NoteCreated(instance);
            _target = instance;
            _pending = null;
            UndoHelper.Separate();
            ctx.Rebuild();
            Frame(instance.transform);
        }

        private static bool TryBounds(GameObject go, out Bounds bounds)
        {
            bounds = new Bounds();
            var found = false;
            foreach (var r in go.GetComponentsInChildren<Renderer>(true))
            {
                return;
            }

            root.Add(Ui.Notice(L10n.Tr("skin.cutterIntro"), "info"));
            var outfits = WornOutfits(ctx.Avatar);
            var places = new List<GameObject> { null };
            places.AddRange(outfits);

            var list = Ui.Box("kn-list");
            foreach (var place in places)
            {
                var p = place;
                var row = Ui.Box("kn-list__row");
                row.Add(Ui.Text(p == null ? L10n.Tr("skin.always") : L10n.Tr("skin.onlyWith", p.name), "kn-list__title", "kn-grow"));
                row.Add(Ui.Button(L10n.Tr("skin.addCutter"), () => AddCutter(ctx, type, p, body), "kn-button--small", "kn-button--primary"));
                list.Add(row);
            }

            root.Add(list);
            root.Add(Ui.Text(L10n.Tr("skin.cutterHow"), "kn-hint"));
        }

        /// <summary>入っている MA に Mesh Cutter があれば、その型（バージョンによっては無い）。</summary>
        private static Type FindMeshCutter()
        {
            foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())
            {
                var t = assembly.GetType(MeshCutterTypeName, false);
                if (t != null && typeof(Component).IsAssignableFrom(t)) return t;
            }

            return null;
        }

        /// <summary>Mesh Cutter を置いて選ぶ（切り取る範囲は MA の画面で決めてもらう）。</summary>
        private static void AddCutter(FeatureContext ctx, Type type, GameObject outfit, SkinnedMeshRenderer body)
        {
            var undoName = L10n.Tr("undo.skin");
            ctx.BeginEdit();
            UndoHelper.Separate();

            var parent = outfit != null ? outfit.transform : ctx.Avatar.transform;
            var go = new GameObject(CutterObjectName);
            Undo.RegisterCreatedObjectUndo(go, undoName);
            go.transform.SetParent(parent, false);
            ctx.NoteCreated(go);
#if KAIHENNAVI_MA
            var cutter = Undo.AddComponent(go, type);
            // 切り取る相手（肌のメッシュ）は先に入れておく。範囲だけを MA の画面で決めてもらう
            var objectProperty = type.GetProperty("Object");
            if (cutter != null && body != null && objectProperty != null && objectProperty.PropertyType == typeof(AvatarObjectReference))
            {
                var reference = new AvatarObjectReference();
                reference.Set(body.gameObject);
                objectProperty.SetValue(cutter, reference, null);
                EditorUtility.SetDirty(cutter);
            }
#else
            Undo.AddComponent(go, type);
#endif

            Selection.activeGameObject = go;
            EditorGUIUtility.PingObject(go);
            EditorUtility.DisplayDialog(L10n.Tr("app.name"), L10n.Tr("skin.cutterAdded"), L10n.Tr("dialog.ok"));
        }
