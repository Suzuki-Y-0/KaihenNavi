                }
                else
                {
                    // 元の場所（番号の上の段）に戻す。見つからなければいちばん上の段
                    var parent = ParentFor(menuRoot, target.name) ?? menuRoot;
                    target.SetParent(parent, false);
                    SortByKey(parent, target);
                }
            });
        }

