// 三角形ごとの内側判定（法線・頭の中心・しきい値・高さ）を数値で検証する。
using System;
using System.Collections.Generic;
using UnityEngine;

namespace Jeni.KaihenNavi
{
    internal static class InnerColorTriangleTests
    {
        private static int _checks;
        private static void Check(bool condition, string message)
        {
            _checks++;
            if (!condition) throw new Exception(message);
        }
        private static bool Near(float a, float b) { return Math.Abs(a - b) < 0.00001f; }
        private static bool Near(Vector3 a, Vector3 b) { return (a - b).sqrMagnitude < 0.00001f; }

        public static void Run()
        {
            var head = new Vector3(0, 1.5f, 0);
            var up = new Vector3(0, 1, 0);
            Check(Near(InnerColorTriangles.Center(head, up, 1.5f), new Vector3(0, 1.56f, 0)),
                "Head center must be 4% of the avatar height above the head bone");

            Check(Near(InnerColorTriangles.Threshold(0), 0.6f), "Narrowest range must use threshold 0.6");
            Check(Near(InnerColorTriangles.Threshold(1), -0.2f), "Widest range must use threshold -0.2");
            Check(Near(InnerColorTriangles.Threshold(InnerColorTriangles.DefaultRange), 0.15f),
                "Default range must use threshold 0.15");
            for (var i = 0; i < 100; i++)
                Check(InnerColorTriangles.Threshold(i / 100f) >
                    InnerColorTriangles.Threshold((i + 1) / 100f), "Larger range must lower the threshold");
            Check(Near(InnerColorTriangles.RangeFromThreshold(0.15f), InnerColorTriangles.DefaultRange),
                "Threshold and range must round trip");

            var center = new Vector3(0, 0, 0);
            Check(Near(InnerColorTriangles.Inward(center, new Vector3(0, -10, 0), up), new Vector3(0, 1, 0)),
                "Vertical direction must be reduced to 30% and normalized");
            Check(Near(InnerColorTriangles.Inward(center, new Vector3(1, 0, 0), up), new Vector3(-1, 0, 0)),
                "Horizontal direction must point toward the center");
            Check(InnerColorTriangles.Inward(center, center, up) == Vector3.zero,
                "A face at the center must have no direction");

            // 横から見た面。法線が頭の中心を向いていれば内側。
            var side = new Vector3(1, 0, 0);
            Check(InnerColorTriangles.IsInner(side, new Vector3(-1, 0, 0), center, up, 0.15f, -1f, 0),
                "A face whose normal points at the head must be inside");
            Check(!InnerColorTriangles.IsInner(side, new Vector3(1, 0, 0), center, up, 0.15f, -1f, 0),
                "A face whose normal points away must be outside");
            Check(!InnerColorTriangles.IsInner(side, new Vector3(-1, 0, 0), center, up, 0.6f, -1f, 0) &&
                InnerColorTriangles.IsInner(side, new Vector3(-1, 0, 0), center, up, -0.2f, -1f, 0),
                "The threshold must widen or narrow the inside");
            Check(!InnerColorTriangles.IsInner(side, Vector3.zero, center, up, 0.15f, -1f, 0),
                "A zero normal must never be inside");

            // 高さ。0 は全部、1 は頭の中心より下だけ。
            var low = new Vector3(1, -0.8f, 0);
            var middle = new Vector3(1, -0.3f, 0);
            var high = new Vector3(1, 0.2f, 0);
            var inward = new Vector3(-1, 0, 0);
            Check(InnerColorTriangles.WithinHeight(low, center, up, -1f, 0) &&
                InnerColorTriangles.WithinHeight(middle, center, up, -1f, 0) &&
                InnerColorTriangles.WithinHeight(high, center, up, -1f, 0),
                "Height 0 must include every face");
            Check(InnerColorTriangles.WithinHeight(low, center, up, -1f, 1) &&
                InnerColorTriangles.WithinHeight(middle, center, up, -1f, 1) &&
                !InnerColorTriangles.WithinHeight(high, center, up, -1f, 1),
                "Height 1 must keep only faces below the head center");

            var positions = new[] { low, middle, high };
            var normals = new[] { inward, inward, inward };
            var triangles = new[] { 0, 1, 2 };
            Check(Near(InnerColorTriangles.Lowest(positions, triangles, center, up), -0.8f),
                "The lowest point must use the height from the head center");
            Check(InnerColorTriangles.Classify(positions, normals, triangles, center, up, 0.15f, 0)[0],
                "The whole hair must be inside at height 0");
            Check(!InnerColorTriangles.Classify(positions, normals, triangles, center, up, 0.15f, 1)[0],
                "A high face must be outside at height 1");

            var all = InnerColorTriangles.Classify(positions, normals, triangles, center, up, 0.15f, 0);
            Check(InnerColorTriangles.InnerTriangles(triangles, all).Length == 3 &&
                InnerColorTriangles.OuterTriangles(triangles, all).Length == 0,
                "All inner triangles must move to the new submesh");
            var none = new bool[] { false };
            Check(InnerColorTriangles.OuterTriangles(triangles, none).Length == 3 &&
                InnerColorTriangles.InnerTriangles(triangles, none).Length == 0,
                "Outer triangles must stay in the original submesh");

            // 頂点法線が無いときは面の向きから法線を作る。
            var faceNormal = InnerColorTriangles.Normal(
                new[] { new Vector3(0, 0, 0), new Vector3(1, 0, 0), new Vector3(0, 1, 0) }, null, 0, 1, 2);
            Check(Near(faceNormal, new Vector3(0, 0, 1)), "Missing vertex normals must fall back to the face normal");

            Console.WriteLine("InnerColor triangle tests passed (" + _checks + " checks).");
            InnerColorAssetTests.Run();
        }
    }
}
