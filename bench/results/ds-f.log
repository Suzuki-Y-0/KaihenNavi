            public float[] weights;
        }

        /// <summary>機能ごとの追加データ（IBackupParticipant が JSON で読み書きする）。</summary>
        [Serializable]
        public sealed class ExtraState
        {
            public string key;
            public string json;
        }

        /// <summary>アバターの識別子（GlobalObjectId）。同名アバターの取り違えを防ぐ。</summary>
