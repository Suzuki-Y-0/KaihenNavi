using System;
using System.Collections.Generic;
using System.Linq;
using UnityEditor;
using UnityEditor.UIElements;
using UnityEngine;
using UnityEngine.UIElements;
using VRC.SDK3.Avatars.Components;
using Object = UnityEngine.Object;

namespace Jeni.KaihenNavi
{
    /// <summary>
    /// 髪の内側の面だけを別の色にする。テクスチャを塗らず、三角形ごとに内側かどうかを決めて
    /// メッシュの複製へ内側用のサブメッシュを足し、複製したマテリアルを当てる。
    /// </summary>
    internal sealed class InnerColorFeature : FeatureBase
    {
        private static readonly string[] ColorKeys = { "pink", "blue", "purple", "silver", "black" };
        private static readonly Color[] Colors =
        {
            new Color(1f, 0.35f, 0.6f), new Color(0.25f, 0.65f, 1f), new Color(0.65f, 0.35f, 1f),
            new Color(0.85f, 0.88f, 0.95f), new Color(0.06f, 0.05f, 0.08f),
        };

        private VRCAvatarDescriptor _avatar;
        private readonly HashSet<SkinnedMeshRenderer> _excluded = new HashSet<SkinnedMeshRenderer>();
        private readonly HashSet<SkinnedMeshRenderer> _selectionInitialized = new HashSet<SkinnedMeshRenderer>();
        private Color _color = Colors[0];
        private float _brightness = 1f;
        private float _range = InnerColorTriangles.DefaultRange;
        private float _height;
        private bool _preview;
        private VisualElement _root;
        private Label _status;
        private IVisualElementScheduledItem _pending;

        public override string Id { get { return "innerColor"; } }
        public override int Number { get { return 13; } }
        public override Color Accent { get { return Ui.Hex("#B78BE8"); } }
        public override bool InTrial { get { return false; } }
        public override bool RefreshOnHierarchyChange { get { return true; } }

        public override VisualElement Build(FeatureContext ctx)
        {
            CancelPending();
            if (_avatar != ctx.Avatar)
            {
                _avatar = ctx.Avatar;
                _excluded.Clear();
                _selectionInitialized.Clear();
            }
            var state = InnerColorState.Load(ctx.Avatar);
            _preview = HasState(state);
            _root = new VisualElement();
            _root.Add(Ui.Notice(L10n.Tr("innerColor.intro"), "info"));
            var targets = HairRenderers(ctx.Avatar);
            _root.Add(Ui.Heading(L10n.Tr("innerColor.which")));
            foreach (var renderer in targets)
            {
                var r = renderer;
                if (_selectionInitialized.Add(r) && DefaultExcluded(r.name)) _excluded.Add(r);
                var hair = HairSlots(ctx.Avatar, r).Select(i => r.sharedMaterials[i]).ToList();
                var supported = hair.Any(Supported);
                var row = Ui.Box("kn-list__row");
                var toggle = new Toggle(r.name) { value = supported && !_excluded.Contains(r) };
                toggle.SetEnabled(supported);
                toggle.RegisterValueChangedCallback(e =>
                {
                    if (e.newValue) _excluded.Remove(r); else _excluded.Add(r);
                    Queue(ctx);
                });
                row.Add(toggle);
                _root.Add(row);
                if (hair.Any(m => m != null && !IsLil(m)))
                    _root.Add(Ui.Text(L10n.Tr("innerColor.otherShader", r.name), "kn-hint"));
                if (hair.Any(m => !Supported(m)))
                    _root.Add(Ui.Text(L10n.Tr("innerColor.unsupported", r.name), "kn-hint"));
            }
            if (targets.Count == 0) _root.Add(Ui.Notice(L10n.Tr("innerColor.noHair"), "warn"));
            if (AvatarMeasure.Bone(ctx.Avatar, HumanBodyBones.Head) == null)
                _root.Add(Ui.Notice(L10n.Tr("innerColor.noHead"), "warn"));

            var color = new ColorField(L10n.Tr("innerColor.color")) { value = _color, showAlpha = false, hdr = false };
            color.RegisterValueChangedCallback(e => { _color = e.newValue; _color.a = 1f; Queue(ctx); });
            _root.Add(color);
            _root.Add(Ui.Chips(ColorKeys.Select(k => L10n.Tr("innerColor.color." + k)).ToList(), -1, i =>
            {
                _color = Colors[i]; color.SetValueWithoutNotify(_color); Queue(ctx);
            }));
            _root.Add(Ui.Slider(L10n.Tr("innerColor.brightness"), 50, 200, _brightness * 100,
                v => { _brightness = v / 100f; Queue(ctx); }));
            _root.Add(Ui.Text(L10n.Tr("innerColor.brightnessHint"), "kn-hint"));

            _root.Add(Ui.Heading(L10n.Tr("innerColor.method")));
            _root.Add(Ui.Slider(L10n.Tr("innerColor.thickness"), 0, 100, _range * 100,
                v => { _range = v / 100f; Queue(ctx); }));
            _root.Add(Ui.Text(L10n.Tr("innerColor.thicknessHint"), "kn-hint"));
            _root.Add(Ui.Slider(L10n.Tr("innerColor.height"), 0, 100, _height * 100,
                v => { _height = v / 100f; Queue(ctx); }));
            _root.Add(Ui.Text(L10n.Tr("innerColor.heightHint"), "kn-hint"));
            _root.Add(Ui.Text(L10n.Tr("innerColor.materialNote"), "kn-hint"));

            var buttons = Ui.Box("kn-row");
            buttons.Add(Ui.Button(L10n.Tr("innerColor.preview"), () => Apply(ctx)));
            buttons.Add(Ui.Button(L10n.Tr("innerColor.reset"), () => Reset(ctx)));
            _root.Add(buttons);
            _status = Ui.Text("", "kn-hint");
            _root.Add(_status);
            return _root;
        }

        public override void OnClosed() { CancelPending(); _preview = false; _root = null; }
        private void CancelPending() { if (_pending != null) _pending.Pause(); _pending = null; }
        private void Queue(FeatureContext ctx)
        {
            CancelPending();
            if (_preview && _root != null) _pending = _root.schedule.Execute(() => Apply(ctx)).StartingIn(300);
        }

        private static bool HasState(InnerColorState state)
        {
            return state != null && ((state.data.entries != null && state.data.entries.Count > 0) ||
                (state.data.meshes != null && state.data.meshes.Count > 0));
        }

        private static bool IsLil(Material material)
        {
            return material != null && material.HasProperty("_lilToonVersion");
        }

        private static bool Supported(Material material)
        {
            return material != null && material.shader != null && (IsLil(material) || material.HasProperty("_Color"));
        }

        private static List<int> HairSlots(VRCAvatarDescriptor avatar, SkinnedMeshRenderer renderer)
        {
            var result = new List<int>();
            var body = AvatarFinder.FindBody(avatar);
            var mats = renderer.sharedMaterials;
            for (var i = 0; i < mats.Length; i++)
                if (mats[i] != null && PartGuesser.Guess(renderer, mats[i], body) == BodyPart.Hair) result.Add(i);
            return result;
        }

        private static List<SkinnedMeshRenderer> HairRenderers(VRCAvatarDescriptor avatar)
        {
            return avatar.GetComponentsInChildren<SkinnedMeshRenderer>(true)
                .Where(r => r.sharedMesh != null && HairSlots(avatar, r).Count > 0).OrderBy(r => r.name).ToList();
        }

        internal static bool DefaultExcluded(string name)
        {
            if (string.IsNullOrEmpty(name)) return false;
            var lower = name.ToLowerInvariant();
            return PartGuesser.LooksLikeCloth(name) || new[]
            {
                "acc", "ribbon", "pin", "clip", "earring", "飾", "リボン", "ピン",
            }.Any(lower.Contains);
        }

        /// <summary>画面に出ない物は判定から除く。EditorOnly は親のタグも調べる。</summary>
        private static bool Visible(Renderer renderer)
        {
            if (!renderer.enabled || renderer.forceRenderingOff || !renderer.gameObject.activeInHierarchy) return false;
            for (var t = renderer.transform; t != null; t = t.parent)
                if (t.gameObject.tag == "EditorOnly") return false;
            return true;
        }

        private sealed class Target
        {
            public SkinnedMeshRenderer renderer;
            public Mesh original;
            public Material[] originalMaterials;
            public List<int> slots;
        }

        private List<Target> Targets(VRCAvatarDescriptor avatar, InnerColorState state)
        {
            var result = new List<Target>();
            foreach (var renderer in HairRenderers(avatar).Where(r => !_excluded.Contains(r) && Visible(r)))
            {
                var entry = FindEntry(state, avatar, renderer);
                var original = entry.originalMesh == null ? null : entry.originalMesh.Load<Mesh>();
                if (original == null)
                {
                    // まだこの髪を変えていない。今のメッシュを元として覚える。
                    original = renderer.sharedMesh;
                    entry.originalMesh = InnerColorState.AssetRef.Of(original);
                    if (entry.originalMaterials.Count == 0)
                        entry.originalMaterials = renderer.sharedMaterials.Select(InnerColorState.AssetRef.Of).ToList();
                }
                if (original == null) continue;

                var materials = entry.originalMaterials.Select(a => a.Load<Material>()).ToArray();
                var body = AvatarFinder.FindBody(avatar);
                var slots = new List<int>();
                for (var i = 0; i < original.subMeshCount && i < materials.Length; i++)
                    if (materials[i] != null && Supported(materials[i]) &&
                        PartGuesser.Guess(renderer, materials[i], body) == BodyPart.Hair) slots.Add(i);
                if (slots.Count == 0) continue;
                result.Add(new Target
                {
                    renderer = renderer, original = original, originalMaterials = materials, slots = slots,
                });
            }
            return result;
        }

        private static InnerColorState.MeshEntry FindEntry(InnerColorState state, VRCAvatarDescriptor avatar,
            SkinnedMeshRenderer renderer)
        {
            var path = HierarchyPath.Get(avatar.transform, renderer.transform);
            var index = Array.IndexOf(renderer.GetComponents<Renderer>(), renderer);
            var key = path.Length + ":" + path + ":" + index;
            var entry = state.data.meshes.FirstOrDefault(m => m.key == key);
            if (entry == null)
            {
                entry = new InnerColorState.MeshEntry
                {
                    key = key, rendererPath = path, rendererIndex = index,
                    originalMesh = new InnerColorState.AssetRef(),
                };
                state.data.meshes.Add(entry);
            }
            return entry;
        }

        private struct Baked
        {
            public Vector3[] positions;
            public Vector3[] normals;
        }

        private static Baked Bake(SkinnedMeshRenderer renderer)
        {
            var mesh = new Mesh { hideFlags = HideFlags.HideAndDontSave };
            try
            {
                renderer.BakeMesh(mesh, false);
                var vertices = mesh.vertices;
                var normals = mesh.normals;
                if (normals.Length != vertices.Length)
                {
                    mesh.RecalculateNormals();
                    normals = mesh.normals;
                }
                var normalMatrix = renderer.transform.localToWorldMatrix.inverse.transpose;
                var result = new Baked { positions = new Vector3[vertices.Length], normals = new Vector3[vertices.Length] };
                for (var i = 0; i < vertices.Length; i++)
                {
                    result.positions[i] = renderer.transform.TransformPoint(vertices[i]);
                    result.normals[i] = i < normals.Length ?
                        normalMatrix.MultiplyVector(normals[i]).normalized : Vector3.zero;
                }
                return result;
            }
            finally { Object.DestroyImmediate(mesh); }
