        /// <summary>同じ機能を続けて操作したまとまりの識別子。旧バックアップでは createdTicks を使う。</summary>
        public long sessionTicks;
        /// <summary>Undo グループ名と翻訳キー。未知の名前は画面で機能名に置き換える。</summary>
        public string operationName;
