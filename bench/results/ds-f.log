        }[code][k.split('.')[-1]]
        data[k]=old
    for k,v in additions.items():
        data[k]=v
    with open(path,"w",encoding="utf-8") as f:
        json.dump(data,f,ensure_ascii=False,indent=2)
        f.write("\n")
    print(code, len(data))
