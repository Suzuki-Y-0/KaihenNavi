        private static InnerColorState.MeshEntry ExistingEntry(InnerColorState state, VRCAvatarDescriptor avatar,
            SkinnedMeshRenderer renderer)
        {
            if (state == null) return null;
            var key = EntryKey(avatar, renderer);
            return state.data.meshes.FirstOrDefault(m => m.key == key);
        }

        private static InnerColorState.MeshEntry FindEntry(InnerColorState state, VRCAvatarDescriptor avatar,
            SkinnedMeshRenderer renderer, Mesh original, Material[] originalMaterials)
        {
            var entry = ExistingEntry(state, avatar, renderer);
            if (entry != null)
            {
                if (entry.originalMesh == null || entry.originalMesh.Load<Mesh>() == null)
                    entry.originalMesh = InnerColorState.AssetRef.Of(original);
                if (entry.originalMaterials == null || entry.originalMaterials.Count == 0)
                    entry.originalMaterials = originalMaterials.Select(InnerColorState.AssetRef.Of).ToList();
                return entry;
            }
            var path = HierarchyPath.Get(avatar.transform, renderer.transform);
            entry = new InnerColorState.MeshEntry
            {
                key = EntryKey(avatar, renderer), rendererPath = path,
                rendererIndex = Array.IndexOf(renderer.GetComponents<Renderer>(), renderer),
                originalMesh = InnerColorState.AssetRef.Of(original),
                originalMaterials = originalMaterials.Select(InnerColorState.AssetRef.Of).ToList(),
            };
            state.data.meshes.Add(entry);
            return entry;
        }

        private static string EntryKey(VRCAvatarDescriptor avatar, SkinnedMeshRenderer renderer)
        {
            var path = HierarchyPath.Get(avatar.transform, renderer.transform);
            var index = Array.IndexOf(renderer.GetComponents<Renderer>(), renderer);
            return path.Length + ":" + path + ":" + index;
        }

