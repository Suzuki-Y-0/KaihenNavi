internal static Vector3 Centroid(Vector3[] positions, int a, int b, int c)
        {
            return (positions[a] + positions[b] + positions[c]) / 3f;
        }

        /// <summary>三角形 1 つずつについて、内側かどうかを返す。</summary>
        internal static bool[] Classify(Vector3[] positions, Vector3[] normals, int[] triangles,
            Vector3 center, Vector3 up, float threshold, float height)
        {
            return Classify(positions, normals, triangles, center, up, threshold, height,
                Lowest(positions, triangles, center, up));
        }

        /// <summary>髪全体で共通の「最も低い点」を使って判定する。</summary>
        internal static bool[] Classify(Vector3[] positions, Vector3[] normals, int[] triangles,
            Vector3 center, Vector3 up, float threshold, float height, float lowest)
        {
            var count = triangles.Length / 3;
            var result = new bool[count];
            for (var t = 0; t < count; t++)
            {
                var a = triangles[t * 3];
                var b = triangles[t * 3 + 1];
                var c = triangles[t * 3 + 2];
                if (a < 0 || b < 0 || c < 0 || a >= positions.Length || b >= positions.Length || c >= positions.Length)
                    continue;
                result[t] = IsInner(Centroid(positions, a, b, c), Normal(positions, normals, a, b, c),
                    center, up, threshold, lowest, height);
            }
            return result;
        }

        /// <summary>内側でない三角形だけを取り出す（元のサブメッシュに残す分）。</summary>
        internal static int[] OuterTriangles(int[] triangles, bool[] inner)
        {
            return Filter(triangles, inner, false);
        }

        /// <summary>内側の三角形だけを取り出す（新しく足すサブメッシュへ入れる分）。</summary>
        internal static int[] InnerTriangles(int[] triangles, bool[] inner)
        {
            return Filter(triangles, inner, true);
        }

        private static int[] Filter(int[] triangles, bool[] inner, bool wantInner)
        {
            var result = new List<int>(triangles.Length);
            var count = Math.Min(inner.Length, triangles.Length / 3);
            for (var t = 0; t < count; t++)
            {
                if (inner[t] != wantInner) continue;
                result.Add(triangles[t * 3]);
                result.Add(triangles[t * 3 + 1]);
                result.Add(triangles[t * 3 + 2]);
            }
            return result.ToArray();
        }
    }
}
