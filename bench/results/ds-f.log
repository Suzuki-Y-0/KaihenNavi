using System.Collections.Generic;
using UnityEngine;

namespace Jeni.KaihenNavi
{
    /// <summary>
    /// 髪の三角形が「内側の面」かどうかを、法線と頭の中心から決める。
    /// 画像の 1 点ずつではなく面ごとに見るので、外側と内側で同じ画像を使う髪でも分けられる。
    /// </summary>
    internal static class InnerColorTriangles
    {
        /// <summary>画面の「内側にする範囲」の初期値（この値のとき、しきい値も 0.15）。</summary>
        internal const float DefaultRange = 0.15f;

        /// <summary>しきい値の初期値。dot(法線, 頭へ向かう向き) がこれより大きい面を内側にする。</summary>
        internal const float DefaultThreshold = 0.15f;

        /// <summary>頭の中心を、Head ボーンから身長の 4% だけ上に置く。</summary>
        internal const float HeadCenterRatio = 0.04f;

        /// <summary>頭へ向かう向きから、上下の成分をこの割合だけ弱める（真下・真上を向いた面を拾いすぎない）。</summary>
        internal const float VerticalDamping = 0.7f;

        /// <summary>画面の「内側にする範囲」を、実際のしきい値に変える。大きいほど内側が広がる（しきい値が下がる）。</summary>
        internal static float ThresholdFromRange(float range)
        {
            // 範囲 0.15 のときしきい値 0.15。範囲を大きくするとしきい値が下がり、内側の面が増える。
            // しきい値は -0.2〜0.6 に収める（それ以上動かしても結果が変わらない）。
            return Mathf.Clamp(0.3f - range, -0.2f, 0.6f);
        }

        /// <summary>頭の中心。Head ボーンの位置に、アバターの上方向 ×（身長 × 0.04）を足す。</summary>
        internal static Vector3 HeadCenter(Vector3 headPosition, Vector3 up, float avatarHeight)
        {
            return headPosition + Unit(up) * (avatarHeight * HeadCenterRatio);
        }

        /// <summary>頭の中心へ向かう向き。上下の成分を 70% 弱めて正規化する。</summary>
        internal static Vector3 InwardDirection(Vector3 point, Vector3 center, Vector3 up)
        {
            var direction = center - point;
            var axis = Unit(up);
            direction -= axis * Vector3.Dot(direction, axis) * VerticalDamping;
            return Unit(direction);
        }

        /// <summary>この面の法線が、頭の中心のほうを向いていれば内側。しきい値は大きいほど厳しい。</summary>
        internal static bool IsInner(Vector3 normal, Vector3 point, Vector3 center, Vector3 up, float threshold)
        {
            var direction = InwardDirection(point, center, up);
            if (direction.sqrMagnitude < 0.000001f) return false;
            var unitNormal = Unit(normal);
            if (unitNormal.sqrMagnitude < 0.000001f) return false;
            return Vector3.Dot(unitNormal, direction) > threshold;
        }

        /// <summary>
        /// 高さの条件。0 なら全部、上げるほど毛先だけになる。
        /// lowest はその髪でいちばん低い面の高さ（頭の中心から下向きが負）。
        /// </summary>
        internal static bool WithinHeight(float pointHeight, float lowest, float height)
        {
            var amount = Mathf.Clamp01(height);
            if (amount <= 0f) return true;
            var cutoff = lowest * amount;
            // いちばん低い面も、高さ 1 のときは残す。
            return pointHeight <= cutoff + 0.00001f;
        }

        /// <summary>
        /// 選んだサブメッシュの三角形から、内側にする三角形を探す。
        /// 返すのは triangles 配列の先頭位置（0, 3, 6 ...）。メッシュから三角形を外すときに使う。
        /// </summary>
        /// <param name="positions">ワールド座標の頂点。</param>
        /// <param name="triangles">サブメッシュの三角形（頂点番号が 3 つずつ）。</param>
        /// <param name="center">頭の中心。</param>
        /// <param name="up">アバターの上方向。</param>
        /// <param name="threshold">法線と頭へ向かう向きの内積のしきい値。</param>
        /// <param name="height">0 で全部、1 でいちばん低いところだけ。</param>
        internal static List<int> Classify(Vector3[] positions, int[] triangles, Vector3 center, Vector3 up,
            float threshold, float height)
        {
            var result = new List<int>();
            if (positions == null || triangles == null || triangles.Length < 3) return result;

            var axis = Unit(up);
            var lowest = float.PositiveInfinity;
            for (var t = 0; t + 2 < triangles.Length; t += 3)
            {
                Vector3 p0, p1, p2;
                if (!TryTriangle(positions, triangles, t, out p0, out p1, out p2)) continue;
                var heightAtCenter = Vector3.Dot((p0 + p1 + p2) / 3f - center, axis);
                if (heightAtCenter < lowest) lowest = heightAtCenter;
            }

            if (float.IsPositiveInfinity(lowest)) return result;
            for (var t = 0; t + 2 < triangles.Length; t += 3)
            {
                Vector3 p0, p1, p2;
                if (!TryTriangle(positions, triangles, t, out p0, out p1, out p2)) continue;
                var centroid = (p0 + p1 + p2) / 3f;
                var heightAtCenter = Vector3.Dot(centroid - center, axis);
                if (!WithinHeight(heightAtCenter, lowest, height)) continue;
                var normal = Vector3.Cross(p1 - p0, p2 - p0);
                if (normal.sqrMagnitude < 0.000000000001f) continue;
                if (IsInner(normal, centroid, center, axis, threshold)) result.Add(t);
            }

            return result;
        }

        private static bool TryTriangle(Vector3[] positions, int[] triangles, int start,
            out Vector3 p0, out Vector3 p1, out Vector3 p2)
        {
            var i0 = triangles[start];
            var i1 = triangles[start + 1];
            var i2 = triangles[start + 2];
            if (i0 < 0 || i1 < 0 || i2 < 0 || i0 >= positions.Length || i1 >= positions.Length || i2 >= positions.Length)
            {
                p0 = p1 = p2 = Vector3.zero;
                return false;
            }

            p0 = positions[i0];
            p1 = positions[i1];
            p2 = positions[i2];
            return true;
        }

        private static Vector3 Unit(Vector3 value)
        {
            return value.sqrMagnitude > 0.000000000001f ? value.normalized : Vector3.zero;
        }
    }
}
