        /// <summary>作ったメッシュを、同じパスのまま中身だけ入れ替えて保存する。</summary>
        internal static Mesh SaveMesh(Mesh copy, string path, string key)
        {
            if (copy == null || !WorkFolders.IsToolPath(path))
                throw new InvalidOperationException(L10n.Tr("innerColor.importFailed"));
            WorkFolders.Ensure(Path.GetDirectoryName(path).Replace('\\\\', '/'));
            var existing = AssetDatabase.LoadAssetAtPath<Mesh>(path);
            if (existing == null)
            {
                AssetDatabase.CreateAsset(copy, path);
            }
            else
            {
                EditorUtility.CopySerialized(copy, existing);
                Object.DestroyImmediate(copy);
                EditorUtility.SetDirty(existing);
            }
            Mark(path, key);
            var result = AssetDatabase.LoadAssetAtPath<Mesh>(path);
            if (result == null) throw new InvalidOperationException(L10n.Tr("innerColor.importFailed"));
            return result;
        }
