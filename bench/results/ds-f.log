        private void Apply(FeatureContext ctx)
        {
            CancelPending();
            if (ctx.Avatar == null || ctx.Avatar != _avatar || EditorApplication.isPlayingOrWillChangePlaymode) return;
            var group = -1;
            InnerColorAssetUndo journal = null;
            var started = EditorApplication.timeSinceStartup;
            try
            {
                var head = AvatarMeasure.Bone(ctx.Avatar, HumanBodyBones.Head);
                if (head == null) throw new InvalidOperationException(L10n.Tr("innerColor.noHead"));
                var state = InnerColorState.Load(ctx.Avatar, true);
                var targets = Targets(ctx.Avatar, state);
                if (targets.Count == 0)
                {
                    Reset(ctx);
                    if (_status != null) _status.text = L10n.Tr("innerColor.noneSelected");
                    return;
                }

                var up = ctx.Avatar.transform.up;
                var center = InnerColorTriangles.Center(head.position, up, AvatarMeasure.Height(ctx.Avatar));
                var threshold = InnerColorTriangles.Threshold(_range);

                ctx.BeginEdit();
                UndoHelper.Separate();
                Undo.IncrementCurrentGroup(); group = Undo.GetCurrentGroup();
                var undoName = L10n.Tr("undo.innerColor");
                Undo.SetCurrentGroupName(undoName);
                journal = InnerColorAssetUndo.Begin(ctx.Avatar);
                state = InnerColorState.Load(ctx.Avatar, true);
                Undo.RecordObject(state, undoName);

                // 旧方式（2nd カラーとマスク画像）の変更は、先に元へ戻してから新方式に切り替える。
                foreach (var entry in state.data.entries)
                {
                    journal.Track(entry.materialPath);
                    journal.Track(entry.maskPath);
                    journal.Track(entry.originalPath);
                    RestoreSecond(ctx.Avatar, entry, undoName);
                }
                state.data.entries.Clear();

                var selected = new HashSet<SkinnedMeshRenderer>(targets.Select(t => t.renderer));
                foreach (var entry in state.data.meshes)
                {
                    var renderer = InnerColorState.RendererFor(ctx.Avatar, entry) as SkinnedMeshRenderer;
                    if (renderer == null || !selected.Contains(renderer)) RestoreMesh(ctx.Avatar, entry, undoName);
                }

                foreach (var target in targets)
                {
                    var entry = FindEntry(state, ctx.Avatar, target.renderer);
                    // 前回の複製ではなく、必ず元のメッシュから作り直す。
                    Undo.RecordObject(target.renderer, undoName);
                    target.renderer.sharedMesh = target.original;
                    target.renderer.sharedMaterials = target.originalMaterials;
                    var baked = Bake(target.renderer);

                    var triangles = new Dictionary<int, int[]>();
                    var lowest = float.MaxValue;
                    foreach (var slot in target.slots)
                    {
                        var list = target.original.GetTriangles(slot);
                        triangles[slot] = list;
                        var slotLowest = InnerColorTriangles.Lowest(baked.positions, list, center, up);
                        lowest = Math.Min(lowest, slotLowest);
                    }
                    if (lowest == float.MaxValue) lowest = 0f;

                    var inner = new Dictionary<int, int[]>();
                    var flagsBySlot = new Dictionary<int, bool[]>();
                    var any = false;
                    foreach (var slot in target.slots)
                    {
                        var flags = InnerColorTriangles.Classify(baked.positions, baked.normals, triangles[slot],
                            center, up, threshold, _height, lowest);
                        flagsBySlot[slot] = flags;
                        inner[slot] = InnerColorTriangles.InnerTriangles(triangles[slot], flags);
                        if (inner[slot].Length > 0) any = true;
                    }
                    if (!any)
                    {
                        RestoreMesh(ctx.Avatar, entry, undoName);
                        continue;
                    }

                    var copy = Object.Instantiate(target.original);
                    copy.name = target.original.name + "_Inner";
                    copy.subMeshCount = target.original.subMeshCount + target.slots.Count;
                    var parts = new List<InnerColorState.MeshPart>();
                    for (var slot = 0; slot < target.original.subMeshCount; slot++)
                    {
                        var list = triangles.ContainsKey(slot) ? triangles[slot] : target.original.GetTriangles(slot);
                        copy.SetTriangles(flagsBySlot.ContainsKey(slot) ?
                            InnerColorTriangles.OuterTriangles(list, flagsBySlot[slot]) : list, slot);
                    }
                    for (var i = 0; i < target.slots.Count; i++)
                    {
                        var slot = target.slots[i];
                        copy.SetTriangles(inner[slot], target.original.subMeshCount + i);
                        parts.Add(new InnerColorState.MeshPart
                        {
                            slot = slot,
                            source = InnerColorState.AssetRef.Of(target.originalMaterials[slot]),
                        });
                    }

                    var meshes = WorkFolders.Ensure(WorkFolders.Meshes(ctx.Avatar.gameObject));
                    entry.meshPath = string.IsNullOrEmpty(entry.meshPath) ?
                        InnerColorAssets.StablePath(meshes, target.original.name, "_Inner.asset", entry.key) : entry.meshPath;
                    journal.Track(entry.meshPath);
                    var saved = InnerColorAssets.SaveMesh(copy, entry.meshPath, entry.key);
                    var materialsFolder = WorkFolders.Ensure(WorkFolders.Materials(ctx.Avatar.gameObject));
                    var owned = new List<Material>();
                    for (var i = 0; i < parts.Count; i++)
                    {
                        var part = parts[i];
                        var source = part.source.Load<Material>();
                        var materialKey = entry.key + "|" + part.slot + "|" + part.source.Key;
                        part.materialPath = InnerColorAssets.StablePath(materialsFolder,
                            source == null ? "Hair" : source.name, "_InnerColor.mat", materialKey);
                        journal.Track(part.materialPath);
                        var material = MaterialCopier.EnsureInnerColorCopy(source, part.materialPath, materialKey, undoName);
                        Tint(material, source, undoName);
                        owned.Add(material);
                    }
                    entry.parts = parts;

                    var originalCount = target.original.subMeshCount;
                    var rendered = new List<Material>();
                    for (var i = 0; i < originalCount; i++)
                        rendered.Add(i < target.originalMaterials.Length ? target.originalMaterials[i] : null);
                    rendered.AddRange(owned);
                    for (var i = originalCount; i < target.originalMaterials.Length; i++)
                        rendered.Add(target.originalMaterials[i]);
                    Undo.RecordObject(target.renderer, undoName);
                    target.renderer.sharedMesh = saved;
                    target.renderer.sharedMaterials = rendered.ToArray();
                    EditorUtility.SetDirty(target.renderer);
                }

                EditorUtility.SetDirty(state);
                journal.Commit(undoName); journal = null;
                ctx.CompleteEdit(group); group = -1;
                _preview = true;
                if (_status != null)
                    _status.text = L10n.Tr("innerColor.doneElapsed",
                        (EditorApplication.timeSinceStartup - started).ToString("F1"));
                SceneView.RepaintAll();
            }
            catch (Exception e)
            {
                if (group >= 0) Undo.RevertAllDownToGroup(group);
                if (journal != null) journal.Rollback();
                if (_status != null) _status.text = L10n.Tr("innerColor.failed", e.Message);
                Debug.LogException(e);
            }
        }

        private void Reset(FeatureContext ctx)
        {
            CancelPending();
            if (ctx.Avatar == null || EditorApplication.isPlayingOrWillChangePlaymode) return;
            var state = InnerColorState.Load(ctx.Avatar);
            var candidates = InnerColorAssets.Candidates(ctx.Avatar, state);
            if (state == null && candidates.Count == 0) return;
            ctx.BeginEdit();
            var undoName = L10n.Tr("undo.innerColor");
            UndoHelper.Separate(); UndoHelper.Begin("innerColor-reset", undoName);
            var journal = InnerColorAssetUndo.Begin(ctx.Avatar);
            try
            {
                // 変更前のファイルを保存する。削除後の Ctrl+Z でも GUID と内容を復元できる。
                foreach (var path in candidates) journal.Track(path);
                if (state != null)
                {
                    Undo.RecordObject(state, undoName);
                    foreach (var entry in state.data.entries) RestoreSecond(ctx.Avatar, entry, undoName);
                    foreach (var entry in state.data.meshes) RestoreMesh(ctx.Avatar, entry, undoName);
                    state.data = new InnerColorState.Data();
                    EditorUtility.SetDirty(state);
                }
                AssetDatabase.SaveAssets();
                // 自分用 Prefab の古い割り当てが、片付けを妨げないよう先に保存する。
                MyAvatar.Save(ctx.Avatar);
                InnerColorAssets.Cleanup(candidates, journal);
                journal.Commit(undoName);
                UndoHelper.End(); UndoHelper.Separate();
            }
            catch (Exception e)
            {
                journal.Rollback();
                UndoHelper.End(); UndoHelper.Separate();
                if (_status != null) _status.text = L10n.Tr("innerColor.failed", e.Message);
                Debug.LogException(e);
                return;
            }
            _preview = false;
            if (_status != null) _status.text = L10n.Tr("innerColor.restored");
            SceneView.RepaintAll();
        }

        /// <summary>複製メッシュと増やしたマテリアルを、元の見た目に戻す。</summary>
        private static void RestoreMesh(VRCAvatarDescriptor avatar, InnerColorState.MeshEntry entry, string undoName)
        {
            var renderer = InnerColorState.RendererFor(avatar, entry) as SkinnedMeshRenderer;
            if (renderer == null) return;
            Undo.RecordObject(renderer, undoName);
            var original = entry.originalMesh == null ? null : entry.originalMesh.Load<Mesh>();
            if (original != null) renderer.sharedMesh = original;
            if (entry.originalMaterials != null && entry.originalMaterials.Count > 0)
                renderer.sharedMaterials = entry.originalMaterials.Select(a => a.Load<Material>()).ToArray();
            EditorUtility.SetDirty(renderer);
        }

        private static void RestoreSecond(VRCAvatarDescriptor avatar, InnerColorState.Entry entry, string undoName)
        {
            var material = AssetDatabase.LoadAssetAtPath<Material>(entry.materialPath);
            if (material == null || !WorkFolders.IsOwnedBy(material, avatar.gameObject)) return;
            // 旧版の控えは読み込めるが、新しい .mat は作らない。
            if (entry.before == null && !string.IsNullOrEmpty(entry.originalPath))
            {
                var before = AssetDatabase.LoadAssetAtPath<Material>(entry.originalPath);
                if (before != null) entry.before = InnerColorState.SecondState.Capture(before);
            }
            if (entry.before != null)
            {
                Undo.RecordObject(material, undoName);
                entry.before.Apply(material);
            }
            foreach (var assignment in entry.assignments)
            {
                var renderer = InnerColorState.RendererFor(avatar, assignment);
                var original = assignment.original.Load<Material>();
                if (renderer == null || original == null) continue;
                var mats = renderer.sharedMaterials;
                if (assignment.slot >= mats.Length || mats[assignment.slot] != material) continue;
                Undo.RecordObject(renderer, undoName);
                mats[assignment.slot] = original;
                renderer.sharedMaterials = mats;
            }
        }

        private void Tint(Material copy, Material source, string undoName)
        {
            if (copy == null) return;
            Undo.RecordObject(copy, undoName);
            if (copy.HasProperty("_Color"))
            {
                var tint = new Color(_color.r * _brightness, _color.g * _brightness, _color.b * _brightness, 1f);
                tint.a = source != null && source.HasProperty("_Color") ? source.GetColor("_Color").a : 1f;
                copy.SetColor("_Color", tint);
            }
            if (copy.HasProperty("_MainTexHSVG"))
            {
                var hsvg = copy.GetVector("_MainTexHSVG");
                hsvg.y = 0f; // 彩度を 0 にして、元の明るさの濃淡だけ残す。
                copy.SetVector("_MainTexHSVG", hsvg);
            }
            EditorUtility.SetDirty(copy);
        }
    }
}
